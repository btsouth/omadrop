# Maintainer: Omadrop contributors
#
# Local, prepared bundle. Run `python3 build-bundle.py --output .` first so the
# tarball sits next to this file, then `makepkg`. The archive is the source;
# nothing is downloaded.
#
# This packages a prebuilt Arch / Omarchy x86_64 bundle. It is not portable to
# arbitrary Linux distributions. The accepted MilkDrop backend is detected at
# runtime and is never packaged.
pkgname=omadrop
pkgver=0.5.0preview1
pkgrel=1
pkgdesc="Music-reactive visuals in any app and the Omarchy music screensaver"
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'python' 'pipewire' 'jq' 'socat' 'ghostty')
source=("omadrop-0.5.0-preview.1.tar.gz")
sha256sums=('SKIP')

package() {
  local bundle="$srcdir/omadrop-0.5.0-preview.1"

  install -d "$pkgdir/usr/share/omadrop-product/bin"
  install -Dm755 "$bundle/share/omadrop-product/bin/omadrop" \
    "$pkgdir/usr/share/omadrop-product/bin/omadrop"
  install -Dm755 "$bundle/share/omadrop-product/bin/omadrop-effects" \
    "$pkgdir/usr/share/omadrop-product/bin/omadrop-effects"
  install -Dm755 "$bundle/share/omadrop-product/bin/omadrop-ui" \
    "$pkgdir/usr/share/omadrop-product/bin/omadrop-ui"

  install -d "$pkgdir/usr/share/omadrop-screensaver/bin"
  install -Dm755 "$bundle/share/omadrop-screensaver/bin/omadrop-screensaver" \
    "$pkgdir/usr/share/omadrop-screensaver/bin/omadrop-screensaver"
  install -Dm755 "$bundle/share/omadrop-screensaver/bin/omadrop-screensaver-run" \
    "$pkgdir/usr/share/omadrop-screensaver/bin/omadrop-screensaver-run"
  install -Dm755 "$bundle/share/omadrop-screensaver/bin/ttfx-music" \
    "$pkgdir/usr/share/omadrop-screensaver/bin/ttfx-music"

  install -Dm644 "$bundle/share/applications/omadrop.desktop" \
    "$pkgdir/usr/share/applications/omadrop.desktop"
  install -Dm644 "$bundle/share/icons/hicolor/scalable/apps/omadrop.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadrop.svg"
  install -Dm644 "$bundle/README.md" "$pkgdir/usr/share/doc/omadrop/README.md"

  install -Dm644 "$bundle/share/licenses/omadrop/LICENSE" \
    "$pkgdir/usr/share/licenses/omadrop/LICENSE"
  install -Dm644 "$bundle/share/licenses/omadrop/ttfx-LICENSE" \
    "$pkgdir/usr/share/licenses/omadrop/ttfx-LICENSE"
  install -Dm644 "$bundle/share/licenses/omadrop/ttfx-NOTICE" \
    "$pkgdir/usr/share/licenses/omadrop/ttfx-NOTICE"

  install -d "$pkgdir/usr/bin"
  ln -s /usr/share/omadrop-product/bin/omadrop "$pkgdir/usr/bin/omadrop"
}
