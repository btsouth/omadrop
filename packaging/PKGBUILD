# Maintainer: Omadrop contributors
#
# Builds Omadrop entirely from source: patched projectM 4.1.7 (with the pinned
# projectm-eval submodule), the MilkDrop collection renderer, ttfx-music and the
# Qt controller. Use packaging/makepkg.sh from a local checkout, which stages
# the source archive and the pinned projectM sources.
pkgname=omadrop
pkgver=0.5.0rc1
pkgrel=1
pkgdesc="Music-reactive MilkDrop visuals and the Omarchy music screensaver"
arch=('x86_64')
url="https://github.com/btsouth/omadrop"
license=('MIT' 'LGPL-2.1-or-later' 'custom')

depends=(
  'qt6-base' 'qt6-declarative' 'python' 'jq' 'socat' 'ghostty'
  'sdl2-compat' 'glew' 'libpng' 'fftw' 'json-c' 'libpulse' 'mesa'
  'pipewire-audio' 'imagemagick' 'curl' 'glib2' 'xorg-xwayland'
)
makedepends=(
  'git' 'python' 'rust' 'cmake' 'ninja' 'pkgconf'
  'qt6-base' 'qt6-declarative'
  'sdl2-compat' 'glew' 'libpng' 'fftw' 'json-c' 'mesa'
)
optdepends=(
  'alacritty: terminal for the Omarchy music screensaver'
  'kitty: terminal for the Omarchy music screensaver'
  'foot: terminal for the Omarchy music screensaver'
  'ffmpeg: output calibration and demo recording'
  'gpu-screen-recorder: demo recording'
)

source=(
  "omadrop-$pkgver.tar.gz"
  "projectm::git+https://github.com/projectM-visualizer/projectm.git#commit=e0b0a967f0ffd7d332106c366668ed271718472b"
  "projectm-eval::git+https://github.com/projectM-visualizer/projectm-eval.git#commit=da885dcdf33620ef26aa04cac9e215378b80252e"
)
sha256sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  export CARGO_HOME="$srcdir/cargo-home"
  # projectM builds its vendor/projectm-eval submodule in-tree; the source list
  # pins it, so place it before configure. build() runs offline after this.
  rm -rf "$srcdir/projectm/vendor/projectm-eval"
  cp -a "$srcdir/projectm-eval" "$srcdir/projectm/vendor/projectm-eval"
  cargo fetch --locked \
    --manifest-path "$srcdir/omadrop-$pkgver/screensaver/ttfx/Cargo.toml"
}

build() {
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_NET_OFFLINE=true
  OMADROP_PROJECTM_SOURCE="$srcdir/projectm" \
    "$srcdir/omadrop-$pkgver/install.sh" --stage "$srcdir/root"
}

package() {
  install -d "$pkgdir/usr/lib/omadrop" "$pkgdir/usr/bin" \
    "$pkgdir/usr/share/applications" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
    "$pkgdir/usr/share/licenses/omadrop"
  cp -a "$srcdir/root/." "$pkgdir/usr/lib/omadrop/"
  ln -s /usr/lib/omadrop/bin/omadrop "$pkgdir/usr/bin/omadrop"
  install -Dm644 "$srcdir/omadrop-$pkgver/packaging/omadrop.desktop" \
    "$pkgdir/usr/share/applications/omadrop.desktop"
  install -Dm644 "$srcdir/omadrop-$pkgver/packaging/omadrop.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadrop.svg"
  for file in "$srcdir/root/licenses/"*; do
    install -Dm644 "$file" "$pkgdir/usr/share/licenses/omadrop/$(basename "$file")"
  done
}
