#!/bin/bash
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
python - "$root" <<'PY'
import json,pathlib,sys
r=pathlib.Path(sys.argv[1]);page=(r/'site/src/pages/index.astro').read_text()
m=json.loads((r/'experiments/milkdrop-audio-pilot/manifest.json').read_text())
for p in m['presets']:
 assert p['label'] in page
 assert (r/f"site/public/media/scenes/collection-{p['number']:02}.jpg").is_file()
assert '18 native scenes' not in page and '18 original scenes' not in page
print('Website collection gallery passed')
PY
