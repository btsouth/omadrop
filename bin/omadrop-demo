#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")

case ${1:-} in
  -h|--help)
    cat <<'EOF'
Usage: omadrop-demo [--loop] [--single|--all]

Play a short, curated showcase of Omadrop's MilkDrop collection.

  --loop    Repeat the sequence instead of closing after the final scene
EOF
    exit 0
    ;;
  --loop)
    export OMADROP_NATIVE_SEQUENCE_ONCE=0
    shift
    ;;
esac

export OMADROP_PERSIST_DISPLAY=0
export OMADROP_REVIEW_DWELL_MS=${OMADROP_DEMO_DWELL_MS:-2500}
export OMADROP_AUTO_QUIT_MS=${OMADROP_DEMO_DURATION_MS:-60000}
if [[ ${OMADROP_NATIVE_SEQUENCE_ONCE:-1} == 0 ]]; then unset OMADROP_AUTO_QUIT_MS; fi
exec "$root/bin/omadrop" "$@"
