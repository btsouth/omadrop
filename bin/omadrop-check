#!/bin/bash
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
mode=${1:---quick}
case $mode in --quick|--full) ;; *) echo 'Usage: omadrop-check [--quick|--full]' >&2; exit 2 ;; esac
native=$root/experiments/projectm-ascii
"$native/build.sh"
for name in live-settings audio-sink-query mpris-state mpris-poller track-session display-session paired-transport paired-sync session-lifecycle audio-features audio-queue music-frame cover-presentation live-compositor; do
  "$native/$name-test"
done
"$native/audio-output-session-test" "$native/fixtures/fake-pw-record"
"$root/bin/omadrop-launcher-test"
"$root/bin/omadrop-calibrate-test"
"$root/bin/demo-rights-audit-test"
"$root/bin/omadrop-site-test"
work=$root/cache/collection-tests
mkdir -p "$work"
g++ -std=c++20 -O2 -Wall -Wextra -I"$native" "$root/experiments/milkdrop-audio-pilot/audio_controls_test.cpp" -o "$work/audio-controls"
"$work/audio-controls"
g++ -std=c++20 -O2 -Wall -Wextra -I"$native" -I"$root/cache/milkdrop-audio-pilot/runtime/include" "$root/experiments/milkdrop-audio-pilot/bridge_test.cpp" -o "$work/bridge" $(pkg-config --cflags --libs sdl2 glew) -L"$root/lib" -lprojectM-4 -lGL
LD_LIBRARY_PATH="$root/lib" "$work/bridge"
python "$root/tests/paired-collection.py"
args=(); [[ $mode != --full ]] || args+=(--full)
python "$root/tests/collection-smoke.py" "${args[@]}"
echo "Omadrop $mode checks passed"
