#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
fixture="$root/experiments/projectm-ascii/scorecard-fixture"
manifest="$root/experiments/projectm-ascii/fixtures/replay-suite.sha256"
verify=0

if [[ ${1:-} == --verify ]]; then
  verify=1
  shift
fi
if (($# > 1 || verify == 1 && $# > 0)); then
  echo "usage: native-replay-fixtures [OUTPUT_DIRECTORY] | --verify" >&2
  exit 2
fi
[[ -x $fixture ]] || {
  echo "native-replay-fixtures: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}

temporary=0
if ((verify)); then
  output=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-replay-fixtures.XXXXXX")
  temporary=1
else
  output=${1:-$root/cache/native-replay-fixtures}
  mkdir -p "$output"
  if find "$output" -mindepth 1 -print -quit | grep -q .; then
    echo "native-replay-fixtures: output directory must be empty: $output" >&2
    exit 2
  fi
fi

cleanup() {
  ((temporary == 0)) || rm -rf -- "$output"
}
trap cleanup EXIT

profiles=(
  structured-electronic
  sparse-acoustic
  dense-compressed
  sustained-vocal
  syncopated-sections
)
for profile in "${profiles[@]}"; do
  "$fixture" "$output/$profile.f32" "$profile"
done

(
  cd "$output"
  sha256sum --check "$manifest"
)

if ((verify)); then
  echo "native replay fixtures match the locked reference hashes"
else
  cp "$manifest" "$output/manifest.sha256"
  echo "native replay fixtures: $output"
fi
