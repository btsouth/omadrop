#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-motion-review-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

"$root/bin/native-motion-review" --help >/dev/null
"$root/experiments/projectm-ascii/scorecard-fixture" \
  "$scratch/source.f32" structured-electronic >/dev/null
OMADROP_MOTION_REVIEW_WIDTH=320 \
OMADROP_MOTION_REVIEW_HEIGHT=180 \
  "$root/bin/native-motion-review" --anonymous \
    "$scratch/source.f32" "$scratch/review" 1 1 >/dev/null

[[ -s $scratch/review/contact-sheet.png ]]
[[ -s $scratch/review/motion-board-1.mp4 ]]
[[ -s $scratch/review/motion-board-2.mp4 ]]
[[ -s $scratch/review/truth/scene-map.tsv ]]
[[ $(wc -l <"$scratch/review/review.tsv") -eq 19 ]]
grep -Fq 'Record decisions in `review.tsv`' "$scratch/review/README.md"

mapfile -t clips < <(find "$scratch/review" -maxdepth 1 \
  -type f -name '[A-R].mp4' -print | sort)
((${#clips[@]} == 18))
[[ $(wc -l <"$scratch/review/truth/scene-map.tsv") -eq 19 ]]

expected="$scratch/expected-scenes"
actual="$scratch/actual-scenes"
"$root/experiments/projectm-ascii/native-scene-list" \
  | cut -f1 | sort >"$expected"
if tail -n +2 "$scratch/review/review.tsv" \
    | grep -Ff "$expected" >/dev/null 2>&1; then
  echo "native motion review test: anonymous worksheet reveals a scene" >&2
  exit 1
fi
tail -n +2 "$scratch/review/truth/scene-map.tsv" \
  | cut -f2 | sort >"$actual"
cmp "$expected" "$actual"

probe=$(ffprobe -v error -show_entries stream=codec_type,width,height \
  -show_entries format=duration -of json "${clips[0]}")
jq -e '
  (.format.duration | tonumber) > 0.95 and
  (.format.duration | tonumber) < 1.05 and
  [.streams[].codec_type] == ["video"] and
  .streams[0].width == 320 and
  .streams[0].height == 180
' >/dev/null <<<"$probe"

board_probe=$(ffprobe -v error -show_entries stream=width,height \
  -of json "$scratch/review/motion-board-1.mp4")
jq -e '.streams[0].width == 960 and .streams[0].height == 540' \
  >/dev/null <<<"$board_probe"

echo "anonymous native motion review passed"
