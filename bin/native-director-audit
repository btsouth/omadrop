#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
replay=$root/experiments/projectm-ascii/native-song-replay
shaders=$root/shaders/native

if (($# != 2)); then
  echo "usage: native-director-audit RAW_F32_STEREO OUTPUT_DIRECTORY" >&2
  exit 2
fi
[[ -x $replay ]] || {
  echo "native-director-audit: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}
input=$(readlink -f "$1")
[[ -f $input ]] || {
  echo "native-director-audit: input not found: $1" >&2
  exit 2
}
output=$(readlink -m "$2")
mkdir -p "$output/replay"
log=$output/director.log
report=$output/director.md

OMADROP_REPLAY_CAPTURE_HOPS=100000 \
  "$replay" "$shaders" "$input" "$output/replay" >"$log"

summary=$(tail -n 1 "$log")
if [[ $summary =~ ^native\ song\ replay\ ([0-9]+([.][0-9]+)?)\ sec, ]]; then
  duration=${BASH_REMATCH[1]}
else
  echo "native-director-audit: replay did not report a valid duration" >&2
  exit 1
fi

audit=$(awk -v duration="$duration" '
  BEGIN {
    valid["flow-carry"] = 1
    valid["focal-morph"] = 1
    valid["depth-travel"] = 1
    valid["controlled-fracture"] = 1
    valid["negative-space-reveal"] = 1
    previous_transition = 0
    maximum_gap = 0
    minimum_gap = duration
    minimum_blend = duration
    maximum_blend = 0
    current_scene = "Depth Tunnel"
    scenes["Depth Tunnel"] = 1
  }
  /^transition / {
    time = $2 + 0
    arrow = 0
    metadata = 0
    for (i = 4; i <= NF; ++i) {
      if ($i == "->") arrow = i
      if ($i ~ /^energy=/) {
        style = $(i - 1)
        metadata = i
        break
      }
    }
    if (!arrow || !metadata || !valid[style]) invalid = 1
    source = ""
    target = ""
    for (i = 4; i < arrow; ++i) {
      source = source (source == "" ? "" : " ") $i
    }
    for (i = arrow + 1; i < metadata - 1; ++i) {
      target = target (target == "" ? "" : " ") $i
    }
    if (source != current_scene || source == target || source == "" || target == "") invalid = 1
    if (transitions > 0) {
      gap = time - previous_transition
      if (gap < minimum_gap) minimum_gap = gap
      if (gap > maximum_gap) maximum_gap = gap
      if (gap < 6.0) rushed = 1
    } else if (time > maximum_gap) {
      maximum_gap = time
    }
    if (time <= previous_transition && transitions > 0) invalid = 1
    pending_target = target
    pending_time = time
    previous_transition = time
    transitions++
  }
  /^scene / {
    time = $2 + 0
    name = ""
    for (i = 4; i <= NF; ++i) {
      name = name (name == "" ? "" : " ") $i
    }
    if (!pending_target || name != pending_target || time <= pending_time) {
      invalid = 1
    }
    blend = time - pending_time
    if (blend < minimum_blend) minimum_blend = blend
    if (blend > maximum_blend) maximum_blend = blend
    if (blend < 1.5 || blend > 3.0) invalid = 1
    scenes[name] = 1
    current_scene = name
    changes++
    pending_target = ""
  }
  END {
    tail_gap = duration - previous_transition
    if (tail_gap > maximum_gap) maximum_gap = tail_gap
    distinct = 0
    for (name in scenes) distinct++
    expected = int(duration / 45.0)
    if (expected < 3) expected = 3
    if (transitions < expected || changes != transitions || distinct < 4) sparse = 1
    if (maximum_gap > 48.0) stuck = 1
    if (pending_target != "") invalid = 1
    if (transitions == 0) {
      minimum_gap = 0
      minimum_blend = 0
    }
    printf "duration=%g transitions=%d distinct=%d min-gap=%g max-gap=%g min-blend=%g max-blend=%g\n", duration, transitions, distinct, minimum_gap, maximum_gap, minimum_blend, maximum_blend
    if (invalid) print "failure=invalid transition sequence"
    if (rushed) print "failure=scene changes less than six seconds apart"
    if (sparse) print "failure=too few scene changes or distinct scenes"
    if (stuck) print "failure=scene held longer than 48 seconds"
    exit invalid || rushed || sparse || stuck
  }
' "$log") || {
  printf '%s\n' "$audit" >&2
  echo "native-director-audit: director pacing failed" >&2
  exit 1
}

metrics=${audit#duration=}
read -r duration_field transitions_field distinct_field min_gap_field \
  max_gap_field min_blend_field max_blend_field <<<"$metrics"
{
  echo '# Native director audit'
  echo
  echo "Audio: $input"
  echo
  echo '| Duration | Transitions | Distinct scenes | Shortest gap | Longest gap | Blend range |'
  echo '| ---: | ---: | ---: | ---: | ---: | ---: |'
  printf '| %.1f s | %s | %s | %.1f s | %.1f s | %.1f to %.1f s |\n' \
    "$duration_field" "${transitions_field#transitions=}" \
    "${distinct_field#distinct=}" "${min_gap_field#min-gap=}" \
    "${max_gap_field#max-gap=}" "${min_blend_field#min-blend=}" \
    "${max_blend_field#max-blend=}"
  echo
  echo 'The audit rejects invalid transition sequences, fewer than four distinct scenes, changes less than six seconds apart, any scene held for more than 48 seconds, and transition blends outside 1.5 to 3 seconds.'
  echo
  echo '```text'
  sed -n '/^\(transition\|scene\) /p' "$log"
  echo '```'
} >"$report"

printf '%s\n' "$audit"
echo "director audit: $report"
echo "native director audit passed"
