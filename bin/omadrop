#!/bin/bash
# Unified Omadrop product launcher.
#
# One command, two modes:
#   milkdrop  the accepted MilkDrop collection (omadrop-milkdrop)
#   omarchy   the music screensaver (omadrop-screensaver)
#
# The remembered mode lives in its own file so the C++ renderer's
# preferences.conf, which it rewrites in full, is never touched.
# ASCII is a per-launch MilkDrop display override, passed as OMADROP_ASCII.
#
# Every helper is a sibling in this installation's bin directory.
set -euo pipefail
if [[ ${OMADROP_TIMING:-0} == 1 ]]; then
  export OMADROP_TIMING_ORIGIN_MS=${OMADROP_TIMING_ORIGIN_MS:-$(date +%s%3N)}
  printf 'timing\t%s\tdispatcher start\n' "$(( $(date +%s%3N) - OMADROP_TIMING_ORIGIN_MS ))" >&2
fi
# Preserve the controller's per-launch captions choice through both launchers.
if [[ ${OMADROP_CAPTIONS:-} == 0 || ${OMADROP_CAPTIONS:-} == 1 ]]; then
  export OMADROP_CAPTIONS
fi

original=("$@")
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
mode_file=${OMADROP_MODE_FILE:-$config_home/omadrop/mode.conf}
milkdrop_backend=${OMADROP_MILKDROP_BACKEND:-$here/omadrop-milkdrop}
omarchy_backend=${OMADROP_OMARCHY_BACKEND:-$here/omadrop-screensaver}
milkdrop_root=$(dirname "$(dirname "$milkdrop_backend")")
milkdrop_live=${OMADROP_MILKDROP_LIVE:-${OMADROP_LIVE_EXECUTABLE:-$milkdrop_root/experiments/projectm-ascii/projectm-ascii-live}}
hyprctl_command=${OMADROP_HYPRCTL:-hyprctl}
screensaver_class=${OMADROP_SCREENSAVER_CLASS:-org.omadrop.screensaver}
effects_binary=${OMADROP_EFFECTS_BINARY:-$here/ttfx-music}

# The native app owns normal launches; explicit engine flags stay compatible.
native_ui=${OMADROP_NATIVE_UI:-$here/omadrop-ui}
if [[ -x $native_ui ]]; then
  export OMADROP_EFFECTS_BINARY=$effects_binary
  export OMADROP_OMARCHY_BACKEND=$omarchy_backend OMADROP_MILKDROP_BACKEND=$milkdrop_backend
  export OMADROP_CONTROLLER_BACKEND=$here/omadrop
  export OMADROP_EFFECTS_HELPER=$here/omadrop-effects
  case ${1:-} in
    "") exec "$native_ui" --controls ;;
    --play) shift; exec "$native_ui" --play "$@" ;;
    --app) shift; exec "$native_ui" "$@" ;;
    --controls) exec "$native_ui" --controls ;;
    --effects) export OMADROP_UI_MODE=omarchy; exec "$native_ui" --controls ;;
  esac
fi

die() { echo "omadrop: $*" >&2; exit 2; }

require_backend() {
  [[ -x $1 ]] || { echo "omadrop: backend not found or not executable: $1" >&2; exit 1; }
}

load_mode() {
  local saved
  saved=$(awk -F= '$1 == "mode" && ($2 == "milkdrop" || $2 == "omarchy") {
    value = $2
  } END { print value }' "$mode_file" 2>/dev/null || true)
  printf '%s' "${saved:-milkdrop}"
}

save_mode() {
  local mode=$1 directory temporary
  directory=$(dirname "$mode_file")
  mkdir -p "$directory"
  temporary=$(mktemp "$directory/.mode.XXXXXX")
  if [[ -r $mode_file ]]; then
    awk -v mode="$mode" '$0 !~ /^mode=/ { print } END { print "mode=" mode }' \
      "$mode_file" >"$temporary"
    chmod --reference="$mode_file" "$temporary" 2>/dev/null || chmod 600 "$temporary"
  else
    printf 'mode=%s\n' "$mode" >"$temporary"
    chmod 600 "$temporary"
  fi
  mv "$temporary" "$mode_file"
}

# Exact process identity: the accepted renderer's executable path, anchored.
milkdrop_running() {
  [[ -n $milkdrop_live ]] || return 1
  pgrep -f "^${milkdrop_live//./\\.}( |$)" >/dev/null 2>&1
}

# Our screensaver is identified by its own Hyprland class, never the stock one.
screensaver_pids() {
  "$hyprctl_command" clients -j 2>/dev/null | jq -r --arg class "$screensaver_class" \
    '.[] | select(.class == $class) | .pid' 2>/dev/null || true
}

omarchy_running() {
  [[ -n $(screensaver_pids) ]]
}

stop_omarchy() {
  local pid attempt
  while read -r pid; do
    [[ -n $pid ]] || continue
    "$hyprctl_command" eval "hl.dispatch(hl.dsp.window.close({ window = 'pid:$pid' }))" \
      >/dev/null 2>&1 || true
    kill -TERM "$pid" 2>/dev/null || true
  done < <(screensaver_pids)
  for ((attempt = 0; attempt < 50; attempt++)); do
    [[ -z $(screensaver_pids) ]] && break
    sleep 0.02
  done
}

stop_milkdrop() {
  [[ -x $milkdrop_backend ]] || return 0
  "$milkdrop_backend" --stop >/dev/null 2>&1 || true
}

stop_all() {
  stop_omarchy
  stop_milkdrop
}

# Effect slugs are the real ttfx subcommands, validated from the installed
# ttfx-music --help before anything is stopped or remembered, so a typo never
# disturbs the running session.
effect_names() {
  [[ -x $effects_binary ]] || return 1
  "$effects_binary" --help 2>/dev/null | awk '
    /^Commands:/ { commands = 1; next }
    commands && /^  / { print $1; next }
    commands { exit }
  ' | grep -vx 'help'
}

valid_effect() {
  effect_names | grep -qx -- "$1"
}

# Legacy invocations forward verbatim to the accepted MilkDrop backend.
case ${1:-} in
  --version|--display-mode|--toggle-secondary|calibrate|pack)
    require_backend "$milkdrop_backend"
    exec "$milkdrop_backend" "${original[@]}"
    ;;
esac

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<'EOF'
Usage: omadrop [--controls|--play]
       omadrop [--mode milkdrop|omarchy] [--single|--all]
       omadrop --mode milkdrop --scene N
       omadrop --controls
       omadrop --effects
       omadrop --effect NAME
       omadrop --preview-effect NAME
       omadrop [--ascii|--no-ascii] [--mode milkdrop]
       omadrop [--current-mode|--stop|--version]

Opening Omadrop shows controls. Opening it while visuals play stops them
and returns to controls. --play starts the remembered mode directly.
Choose a mode with --mode. Omarchy keeps its authored characters.
MilkDrop controls, calibration and pack commands remain available.

--scene N starts the MilkDrop collection on scene number N (1..21), honoring
hidden scenes from omadrop/scenes.conf.

--effects opens the effect browser: preview, favorite and hide the Omarchy
screensaver effects, manage the lists in bulk, or start a rotation.
--effect NAME launches one Omarchy effect and remembers Omarchy mode.
--preview-effect NAME plays one effect on one display without changing the
remembered mode or display choice.
EOF
  exit 0
fi

mode_arg=
current=0
stop=0
play=0
effect=
preview_effect=
scene=
scene_set=0
ascii_override=
ascii_set=0
display_args=()
passthrough=()

while (($#)); do
  case $1 in
    --mode)
      (($# >= 2)) || die "--mode requires milkdrop or omarchy"
      case $2 in
        milkdrop|omarchy) mode_arg=$2 ;;
        *) die "--mode requires milkdrop or omarchy" ;;
      esac
      shift 2
      ;;
    --scene)
      (($# >= 2)) || die "--scene requires a scene number"
      [[ $2 =~ ^[1-9][0-9]*$ ]] || die "--scene requires a scene number"
      scene=$2
      scene_set=1
      shift 2
      ;;
    --effect)
      (($# >= 2)) || die "--effect requires an effect name"
      effect=$2
      shift 2
      ;;
    --preview-effect)
      (($# >= 2)) || die "--preview-effect requires an effect name"
      preview_effect=$2
      shift 2
      ;;
    --play) play=1; shift ;;
    --current-mode) current=1; shift ;;
    --ascii) ascii_override=1; ascii_set=1; shift ;;
    --no-ascii) ascii_override=0; ascii_set=1; shift ;;
    --single|--all) display_args+=("$1"); shift ;;
    --stop) stop=1; shift ;;
    --original) passthrough+=(--original); shift ;;
    *) die "unknown option: $1" ;;
  esac
done

# A preview has one purpose; reject ambiguous options before side effects.
if [[ -n $preview_effect ]] && { [[ -n $effect || -n $mode_arg ]] ||
    ((current || stop || play || ascii_set || scene_set)) ||
    ((${#display_args[@]} || ${#passthrough[@]})); }; then
  die "--preview-effect must be used on its own"
fi
if [[ -n $effect ]] && ((current || stop || scene_set)); then
  die "--effect cannot be combined with a query, stop or scene"
fi

# Validate the requested effect before anything is stopped or remembered.
if [[ -n $effect || -n $preview_effect ]]; then
  if [[ -n $mode_arg && $mode_arg != omarchy ]]; then
    die "--effect and --preview-effect help the Omarchy mode only"
  fi
  [[ -x $effects_binary ]] \
    || die "cannot validate effects: effects binary not found: $effects_binary"
  valid_effect "${effect:-$preview_effect}" \
    || die "unknown effect: ${effect:-$preview_effect}"
fi

if ((stop)); then
  stop_all
  exit 0
fi

if ((current)); then
  printf '%s\n' "$(load_mode)"
  exit 0
fi

# A preview plays one effect on one display and leaves the remembered mode and
# display choice alone, so the browser can come back to where it was.
if [[ -n $preview_effect ]]; then
  require_backend "$omarchy_backend"
  export OMADROP_PERSIST_DISPLAY=0 OMADROP_MONITORS=single
  stop_all
  exec "$omarchy_backend" --single --effect "$preview_effect"
fi

if [[ -n $effect ]]; then
  mode_arg=omarchy
fi

launch_requested=$play
[[ -n $mode_arg ]] && launch_requested=1
((${#display_args[@]})) && launch_requested=1
((${#passthrough[@]})) && launch_requested=1
((ascii_set)) && launch_requested=1
((scene_set)) && launch_requested=1

target_mode=${mode_arg:-$(load_mode)}
if ((ascii_set)) && [[ $target_mode == omarchy ]]; then
  die "--ascii/--no-ascii apply to MilkDrop mode only"
fi
if ((scene_set)) && [[ $target_mode == omarchy ]]; then
  die "--scene applies to MilkDrop mode only"
fi

if [[ $target_mode == omarchy && ${#passthrough[@]} -gt 0 ]]; then
  die "--original applies to MilkDrop mode only"
fi
case $target_mode in
  milkdrop) require_backend "$milkdrop_backend" ;;
  omarchy) require_backend "$omarchy_backend" ;;
esac

# Installations without the native UI still never start playback implicitly.
if ((launch_requested == 0)); then
  if milkdrop_running || omarchy_running; then
    stop_all
    exit 0
  fi
  echo "omadrop: controls are unavailable; build or install omadrop-ui" >&2
  exit 1
fi

[[ -n $mode_arg ]] && save_mode "$mode_arg"

stop_all

case $target_mode in
  milkdrop)
    require_backend "$milkdrop_backend"
    ((ascii_set)) && export OMADROP_ASCII=$ascii_override
    if ((scene_set)); then
      exec "$milkdrop_backend" "${display_args[@]}" "${passthrough[@]}" --scene "$scene"
    fi
    exec "$milkdrop_backend" "${display_args[@]}" "${passthrough[@]}"
    ;;
  omarchy)
    require_backend "$omarchy_backend"
    if [[ -n $effect ]]; then
      exec "$omarchy_backend" "${display_args[@]}" --effect "$effect"
    else
      exec "$omarchy_backend" "${display_args[@]}"
    fi
    ;;
  *) die "unknown mode: $target_mode" ;;
esac
