#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
replay="$root/experiments/projectm-ascii/native-song-replay"
shaders="$root/shaders/native"

include_audio=1
if (($# > 0)) && [[ $1 == --silent ]]; then
  include_audio=0
  shift
fi

if (($# < 3 || $# > 4)); then
  echo "usage: native-song-video [--silent] RAW_F32_STEREO OUTPUT_MP4 SCENE [MAX_SECONDS]" >&2
  exit 2
fi

[[ -x $replay ]] || {
  echo "native-song-video: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}
command -v ffmpeg >/dev/null || {
  echo "native-song-video: ffmpeg is required" >&2
  exit 2
}

music=$(readlink -f "$1")
[[ -f $music ]] || {
  echo "native-song-video: input not found: $1" >&2
  exit 2
}
output=$2
scene=$3
maximum_seconds=${4:-}
timeline_output=${OMADROP_VIDEO_TIMELINE_OUTPUT:-}
capture_start=${OMADROP_VIDEO_START_SECONDS:-0}
if [[ -e $output ]]; then
  echo "native-song-video: output already exists: $output" >&2
  exit 2
fi
if [[ -n $timeline_output ]]; then
  timeline_output=$(readlink -m "$timeline_output")
  if [[ -e $timeline_output ]]; then
    echo "native-song-video: timeline output already exists: $timeline_output" >&2
    exit 2
  fi
fi
if [[ -n $maximum_seconds && ! $maximum_seconds =~ ^[1-9][0-9]*$ ]]; then
  echo "native-song-video: MAX_SECONDS must be a positive integer" >&2
  exit 2
fi
if [[ ! $capture_start =~ ^[0-9]+$ ]]; then
  echo "native-song-video: OMADROP_VIDEO_START_SECONDS must be a non-negative integer" >&2
  exit 2
fi
if ((capture_start > 0)) && [[ -z $maximum_seconds ]]; then
  echo "native-song-video: a capture start requires MAX_SECONDS" >&2
  exit 2
fi
if [[ -n $maximum_seconds ]] && ((capture_start >= maximum_seconds)); then
  echo "native-song-video: capture start must be earlier than MAX_SECONDS" >&2
  exit 2
fi

width=${OMADROP_VIDEO_WIDTH:-960}
height=${OMADROP_VIDEO_HEIGHT:-540}
if [[ ! $width =~ ^[0-9]+$ || ! $height =~ ^[0-9]+$ \
      || $width -lt 320 || $width -gt 1920 \
      || $height -lt 180 || $height -gt 1080 ]]; then
  echo "native-song-video: resolution must be within 320x180 and 1920x1080" >&2
  exit 2
fi

mkdir -p "$(dirname "$output")"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-song-video.XXXXXX")
frame_stream="$scratch/frames.rgb"
mkdir -p "$scratch/replay"
mkfifo "$frame_stream"
encoder=0
cleanup() {
  if ((encoder > 0)); then
    kill "$encoder" 2>/dev/null || true
    wait "$encoder" 2>/dev/null || true
  fi
  rm -rf -- "$scratch"
}
trap cleanup EXIT

encoder_command=(
  ffmpeg -hide_banner -loglevel error -y
  -f rawvideo -pixel_format rgb24 -video_size "${width}x${height}"
  -framerate 60 -i "$frame_stream"
)
if ((include_audio)); then
  encoder_command+=(
    -f f32le -ar 44100 -ac 2
  )
  if ((capture_start > 0)); then
    encoder_command+=(-ss "$capture_start")
  fi
  encoder_command+=(
    -i "$music"
    -map 0:v:0 -map 1:a:0
  )
else
  encoder_command+=(-map 0:v:0 -an)
fi
encoder_command+=(
  -c:v libx264 -preset fast -crf 18 -pix_fmt yuv420p -shortest
)
if ((include_audio)); then
  encoder_command+=(-c:a aac -b:a 192k)
fi
encoder_command+=("$output")
"${encoder_command[@]}" >"$scratch/ffmpeg.log" 2>&1 &
encoder=$!

replay_environment=(
  env
  OMADROP_REPLAY_SCENE="$scene"
  OMADROP_REPLAY_CAPTURE_HOPS=100000
  OMADROP_REPLAY_WIDTH="$width"
  OMADROP_REPLAY_HEIGHT="$height"
  OMADROP_REPLAY_FRAME_STREAM="$frame_stream"
)
if [[ -n $maximum_seconds ]]; then
  replay_environment+=(OMADROP_REPLAY_MAX_SECONDS="$maximum_seconds")
fi
if ((capture_start > 0)); then
  replay_environment+=(OMADROP_REPLAY_STREAM_START_SECONDS="$capture_start")
fi

set +e
"${replay_environment[@]}" \
  "$replay" "$shaders" "$music" "$scratch/replay" \
  >"$scratch/replay.log" 2>&1
replay_status=$?
wait "$encoder"
encoder_status=$?
encoder=0
set -e

if ((replay_status != 0 || encoder_status != 0)); then
  echo "native-song-video: replay or encoding failed" >&2
  cat "$scratch/replay.log" >&2
  cat "$scratch/ffmpeg.log" >&2
  exit 1
fi

if [[ -n $timeline_output ]]; then
  [[ -s $scratch/replay/timeline.tsv ]] || {
    echo "native-song-video: replay did not create a timeline" >&2
    exit 1
  }
  if ((capture_start > 0)); then
    mkdir -p "$(dirname "$timeline_output")"
    awk -F '\t' -v OFS='\t' -v start="$capture_start" \
      'NR == 1 { print; next }
       ($1 + 0) >= start { $1 = sprintf("%.6f", ($1 + 0) - start); print }' \
      "$scratch/replay/timeline.tsv" >"$timeline_output"
  else
    install -Dm644 "$scratch/replay/timeline.tsv" "$timeline_output"
  fi
fi

echo "continuous review: $output"
