#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
replay="$root/experiments/projectm-ascii/native-song-replay"
shaders="$root/shaders/native"

if (($# < 2 || $# > 3)); then
  echo "usage: native-song-gallery RAW_F32_STEREO OUTPUT_DIRECTORY [MAX_SECONDS]" >&2
  exit 2
fi

[[ -x $replay ]] || {
  echo "native-song-gallery: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}
command -v magick >/dev/null || {
  echo "native-song-gallery: ImageMagick is required" >&2
  exit 2
}

music=$(readlink -f "$1")
[[ -f $music ]] || {
  echo "native-song-gallery: input not found: $1" >&2
  exit 2
}
output=$2
maximum_seconds=${3:-}
if [[ -n $maximum_seconds && ! $maximum_seconds =~ ^[1-9][0-9]*$ ]]; then
  echo "native-song-gallery: MAX_SECONDS must be a positive integer" >&2
  exit 2
fi

mkdir -p "$output"
if find "$output" -mindepth 1 -print -quit | grep -q .; then
  echo "native-song-gallery: output directory must be empty: $output" >&2
  exit 2
fi

scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-song-gallery.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

scenes=(
  depth-tunnel centrifuge wire-organism prism-garden orbital-loom
  tidal-grid pulse-cathedral constellation-field spectral-ribbons bloom-engine
)
names=(
  'Depth Tunnel' 'Centrifuge' 'Wire Organism' 'Prism Garden' 'Orbital Loom'
  'Tidal Grid' 'Pulse Cathedral' 'Constellation Field' 'Spectral Ribbons'
  'Bloom Engine'
)

matrix_frames=()
for index in "${!scenes[@]}"; do
  scene=${scenes[$index]}
  name=${names[$index]}
  directory="$output/$scene"
  mkdir -p "$directory"
  echo "rendering $name"
  replay_environment=(
    env
    OMADROP_REPLAY_SCENE="$scene"
    OMADROP_REPLAY_CAPTURE_HOPS=120
    OMADROP_REPLAY_WIDTH=960
    OMADROP_REPLAY_HEIGHT=540
  )
  if [[ -n $maximum_seconds ]]; then
    replay_environment+=(OMADROP_REPLAY_MAX_SECONDS="$maximum_seconds")
  fi
  "${replay_environment[@]}" \
    "$replay" "$shaders" "$music" "$directory" >"$directory/replay.log"

  mapfile -t frames < <(find "$directory" -maxdepth 1 -name '*.ppm' -print | sort)
  ((${#frames[@]} > 0)) || {
    echo "native-song-gallery: no frames rendered for $name" >&2
    exit 1
  }

  magick montage "${frames[@]}" -thumbnail 320x180 -set label '%t' \
    -tile 6x -geometry +6+22 -background '#05070a' -fill white \
    -font Adwaita-Mono -pointsize 14 "$output/$scene.png"

  last=$((${#frames[@]} - 1))
  for position in 0 1 2 3 4; do
    selected=$((last * position / 4))
    link="$scratch/$(printf '%02d' "$index")-$scene-$((position + 1)).ppm"
    ln -s "${frames[$selected]}" "$link"
    matrix_frames+=("$link")
  done
done

magick montage "${matrix_frames[@]}" -thumbnail 320x180 -set label '%t' \
  -tile 5x10 -geometry +6+22 -background '#05070a' -fill white \
  -font Adwaita-Mono -pointsize 14 "$output/scene-matrix.png"

duration=$(awk -v bytes="$(stat -c %s "$music")" \
  'BEGIN { printf "%.1f", bytes / (44100 * 2 * 4) }')
reviewed=$duration
if [[ -n $maximum_seconds ]]; then
  reviewed=$(awk -v duration="$duration" -v limit="$maximum_seconds" \
    'BEGIN { printf "%.1f", duration < limit ? duration : limit }')
fi
echo "reviewed $reviewed seconds from $music"
echo "full-song scene matrix: $output/scene-matrix.png"
echo "per-scene contact sheets: $output/{scene}.png"
