#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
validator=$root/bin/omadrop-pack
example=$root/examples/scene-pack
scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-pack-test.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

"$validator" validate "$example" >"$scratch/valid.log"
grep -q '^scene pack valid:' "$scratch/valid.log"

make_case() {
  local name=$1
  cp -R "$example" "$scratch/$name"
}

expect_invalid() {
  local name=$1 expected=$2
  if "$validator" validate "$scratch/$name" >"$scratch/$name.log" 2>&1; then
    echo "omadrop-pack-test: invalid case passed: $name" >&2
    exit 1
  fi
  grep -q "$expected" "$scratch/$name.log"
}

make_case legacy-v1
python3 - "$scratch/legacy-v1/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["schemaVersion"] = 1
data.pop("sceneApiVersion")
json.dump(data, open(path, "w", encoding="utf-8"))
PY
"$validator" validate "$scratch/legacy-v1" >"$scratch/legacy-v1.log"
grep -q '^scene pack valid:' "$scratch/legacy-v1.log"
python3 - "$validator" "$scratch/legacy-v1" "$root" <<'PY'
import pathlib
import runpy
import sys
validator, pack, root = sys.argv[1:]
module = runpy.run_path(validator)
_, _, api_root = module["validate"](pack, run_dynamic=False, emit=False)
assert api_root == pathlib.Path(root) / "scene-api" / "1"
assert (api_root / "scene-uniforms.glsl").is_file()
PY

make_case missing-role
python3 - "$scratch/missing-role/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["scenes"][0]["roles"].remove("hat")
json.dump(data, open(path, "w", encoding="utf-8"))
PY
expect_invalid missing-role 'roles is missing: hat'

make_case path-escape
python3 - "$scratch/path-escape/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["scenes"][0]["shader"] = "../outside.frag"
json.dump(data, open(path, "w", encoding="utf-8"))
PY
expect_invalid path-escape 'must stay inside the pack'

make_case forbidden-sampler
printf '\nuniform samplerCube externalTexture;\n' \
  >>"$scratch/forbidden-sampler/scenes/local-orbit.frag"
expect_invalid forbidden-sampler 'forbidden unsupported samplers'

make_case dynamic-loop
printf '\nvoid unsafeLoop() { for (int i = 0; i < int(sceneBeats); ++i) {} }\n' \
  >>"$scratch/dynamic-loop/scenes/local-orbit.frag"
expect_invalid dynamic-loop 'non-static for loop'

make_case shader-symlink
ln -s local-orbit.frag "$scratch/shader-symlink/scenes/link.frag"
python3 - "$scratch/shader-symlink/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["scenes"][0]["shader"] = "scenes/link.frag"
json.dump(data, open(path, "w", encoding="utf-8"))
PY
expect_invalid shader-symlink 'may not use symlinks'

make_case future-schema
python3 - "$scratch/future-schema/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["schemaVersion"] = 3
json.dump(data, open(path, "w", encoding="utf-8"))
PY
expect_invalid future-schema 'schemaVersion must be one of 1, 2'

make_case future-scene-api
python3 - "$scratch/future-scene-api/pack.json" <<'PY'
import json
import sys
path = sys.argv[1]
data = json.load(open(path, encoding="utf-8"))
data["sceneApiVersion"] = 2
json.dump(data, open(path, "w", encoding="utf-8"))
PY
expect_invalid future-scene-api 'sceneApiVersion must be one of 1'

make_case global-pulse
python3 - "$scratch/global-pulse/scenes/local-orbit.frag" <<'PY'
import sys
path = sys.argv[1]
open(path, "w", encoding="utf-8").write('''#version 330 core
in vec2 uv;
out vec4 color;
#include "scene-uniforms.glsl"
void main() {
    float transient = max(kick, max(snare, hat));
    color = vec4(vec3(0.08 + transient), 1.0);
}
''')
PY
expect_invalid global-pulse 'global pulse exceeds declaration'

make_case duplicate-role-shape
python3 - "$scratch/duplicate-role-shape/scenes/local-orbit.frag" <<'PY'
import sys
path = sys.argv[1]
open(path, "w", encoding="utf-8").write('''#version 330 core
in vec2 uv;
out vec4 color;
#include "scene-uniforms.glsl"
void main() {
    float transient = max(kick, max(snare, hat));
    float spot = 1.0 - smoothstep(0.025, 0.075, length(uv - vec2(0.5)));
    color = vec4(vec3(0.08 + transient * spot), 1.0);
}
''')
PY
expect_invalid duplicate-role-shape 'do not have distinct visual roles'

make_case invisible-role
python3 - "$scratch/invisible-role/scenes/local-orbit.frag" <<'PY'
import sys
path = sys.argv[1]
open(path, "w", encoding="utf-8").write('''#version 330 core
in vec2 uv;
out vec4 color;
#include "scene-uniforms.glsl"
void main() {
    float kickSpot = 1.0 - smoothstep(0.010, 0.018,
        length(uv - vec2(0.25, 0.30)));
    float snareSpot = 1.0 - smoothstep(0.010, 0.018,
        length(uv - vec2(0.50, 0.55)));
    float hatSpot = 1.0 - smoothstep(0.010, 0.018,
        length(uv - vec2(0.75, 0.70)));
    color = vec4(vec3(0.08 + 0.10 * (kick * kickSpot
        + snare * snareSpot + hat * hatSpot)), 1.0);
}
''')
PY
expect_invalid invisible-role 'kick response is not visible'

if "$validator" author "$example" missing-scene \
    >"$scratch/missing-scene.log" 2>&1; then
  echo "omadrop-pack-test: missing author scene passed" >&2
  exit 1
fi
grep -q 'scene slug not found: missing-scene' "$scratch/missing-scene.log"

XDG_DATA_HOME="$scratch/data" "$validator" list >"$scratch/list-empty.log"
grep -q '^no community scene packs installed$' "$scratch/list-empty.log"
XDG_DATA_HOME="$scratch/data" "$validator" install "$example" \
  >"$scratch/install.log"
grep -q '^community pack installed: org.omadrop.example.local-orbit 1.0.0$' \
  "$scratch/install.log"
grep -q 'outside Omadrop.*official automatic rotation' "$scratch/install.log"
XDG_DATA_HOME="$scratch/data" "$validator" list >"$scratch/list.log"
grep -q $'^org.omadrop.example.local-orbit\t1.0.0\tLocal Orbit$' \
  "$scratch/list.log"
if XDG_DATA_HOME="$scratch/data" "$validator" install "$example" \
    >"$scratch/install-again.log" 2>&1; then
  echo "omadrop-pack-test: duplicate install passed" >&2
  exit 1
fi
grep -q 'community pack is already installed' "$scratch/install-again.log"
XDG_DATA_HOME="$scratch/data" "$validator" remove \
  org.omadrop.example.local-orbit 1.0.0 >"$scratch/remove.log"
grep -q '^community pack removed: org.omadrop.example.local-orbit 1.0.0$' \
  "$scratch/remove.log"
XDG_DATA_HOME="$scratch/data" "$validator" list >"$scratch/list-removed.log"
grep -q '^no community scene packs installed$' "$scratch/list-removed.log"

make_case install-symlink
ln -s pack.json "$scratch/install-symlink/unreferenced-link"
if XDG_DATA_HOME="$scratch/data" "$validator" install "$scratch/install-symlink" \
    >"$scratch/install-symlink.log" 2>&1; then
  echo "omadrop-pack-test: symlinked pack install passed" >&2
  exit 1
fi
grep -q 'installed packs may not contain symlinks' \
  "$scratch/install-symlink.log"

echo "scene pack validation passed"
