#!/bin/bash
set -euo pipefail
root=$(dirname "$(dirname "$(readlink -f "$0")")")
export OMADROP_ENGINE=native
export OMADROP_NATIVE_SCENE=ink-current
export OMADROP_NATIVE_HOLD=1
export OMADROP_ASCII=${OMADROP_ASCII:-0}
export OMADROP_COVER_HOLD_SECONDS=1
export OMADROP_COVER_DISSOLVE_SECONDS=2
export OMADROP_HIDE_FIRST_RUN_CONTROLS=1
exec "$root/bin/omadrop" "$@"
