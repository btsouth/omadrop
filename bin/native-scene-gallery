#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
renderer="$root/experiments/projectm-ascii/native-renderer-test"
scene_list="$root/experiments/projectm-ascii/native-scene-list"
output=${1:-$root/cache/native-scene-gallery}

[[ -x $renderer && -x $scene_list ]] || {
  echo "native-scene-gallery: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}
command -v magick >/dev/null || {
  echo "native-scene-gallery: ImageMagick is required" >&2
  exit 2
}

mkdir -p "$output"
mapfile -t scenes < <("$scene_list")
scene_count=${#scenes[@]}
((scene_count > 0)) || {
  echo "native-scene-gallery: native scene registry is empty" >&2
  exit 1
}
if ((scene_count <= 4)); then
  scene_columns=2
elif ((scene_count <= 9)); then
  scene_columns=3
else
  scene_columns=4
fi
scene_rows=$(((scene_count + scene_columns - 1) / scene_columns))
scene_tile="${scene_columns}x${scene_rows}"
palettes=(
  'neutral:#B5A8A7'
  'electric:#FAF50A'
  'red:#F90400'
  'gold:#DEC82D'
  'green:#62B100'
  'cyan:#0DFEFF'
)

palette_sheets=()
ascii_palette_sheets=()
for entry in "${palettes[@]}"; do
  name=${entry%%:*}
  color=${entry#*:}
  directory="$output/$name"
  mkdir -p "$directory"
  echo "rendering $name palette $color"
  OMADROP_REFERENCE_COLOR="$color" \
    "$renderer" "$root/shaders/native" "$directory" \
    >"$directory/audit.log"
  palette_images=()
  ascii_images=()
  for row in "${scenes[@]}"; do
    slug=${row%%$'\t'*}
    palette_images+=("$directory/$slug.ppm")
    ascii_images+=("$directory/ascii/$slug.ppm")
  done
  sheet="$output/$name.png"
  magick montage "${palette_images[@]}" -thumbnail 384x216 -set label '%t' \
    -tile "$scene_tile" -geometry +6+22 -background '#05070a' -fill white \
    -font Adwaita-Mono -pointsize 15 "$sheet"
  palette_sheets+=("$sheet")
  ascii_sheet="$output/ascii-$name.png"
  magick montage "${ascii_images[@]}" -thumbnail 384x216 -set label '%t' \
    -tile "$scene_tile" -geometry +6+22 -background '#05070a' -fill white \
    -font Adwaita-Mono -pointsize 15 "$ascii_sheet"
  ascii_palette_sheets+=("$ascii_sheet")
done

magick montage "${palette_sheets[@]}" -thumbnail 960x520 -set label '%t' \
  -tile 2x3 -geometry +10+24 -background '#05070a' -fill white \
  -font Adwaita-Mono -pointsize 18 "$output/palette-matrix.png"
magick "$output/neutral.png" -colorspace Gray \
  "$output/grayscale-matrix.png"
magick montage "${ascii_palette_sheets[@]}" -thumbnail 960x520 -set label '%t' \
  -tile 2x3 -geometry +10+24 -background '#05070a' -fill white \
  -font Adwaita-Mono -pointsize 18 "$output/ascii-palette-matrix.png"
magick "$output/ascii-neutral.png" -colorspace Gray \
  "$output/ascii-grayscale-matrix.png"

echo "palette review: $output/palette-matrix.png"
echo "grayscale review: $output/grayscale-matrix.png"
echo "ASCII palette review: $output/ascii-palette-matrix.png"
echo "ASCII grayscale review: $output/ascii-grayscale-matrix.png"
