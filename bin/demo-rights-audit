#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")

if (($# < 1 || $# > 2)); then
  echo "usage: demo-rights-audit AUDIO_FILE [RIGHTS_MANIFEST]" >&2
  exit 2
fi
audio=$(readlink -f "$1")
manifest=${2:-$root/demo/music-rights.json}
manifest=$(readlink -f "$manifest")
[[ -f $audio && -f $manifest && ! -L $manifest ]] || {
  echo "demo-rights-audit: audio and a regular rights manifest are required" >&2
  exit 2
}
for command in jq sha256sum ffprobe; do
  command -v "$command" >/dev/null || {
    echo "demo-rights-audit: required command not found: $command" >&2
    exit 2
  }
done

jq -e '
  .format == 1
  and (.tracks | type == "array" and length > 0)
  and all(.tracks[];
    (.id | type == "string" and test("^[a-z0-9][a-z0-9-]*$"))
    and (.title | type == "string" and length > 0)
    and (.creator | type == "string" and length > 0)
    and (.source_url | test("^https://"))
    and .license == "CC BY 3.0 Unported"
    and .license_url == "https://creativecommons.org/licenses/by/3.0/"
    and (.sha256 | test("^[0-9a-f]{64}$"))
    and (.duration_seconds | type == "number" and . > 1)
    and (.verified_on | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")))
' "$manifest" >/dev/null || {
  echo "demo-rights-audit: invalid or incomplete rights manifest" >&2
  exit 1
}

sha=$(sha256sum "$audio" | awk '{ print $1 }')
track=$(jq -ce --arg sha "$sha" '
  [.tracks[] | select(.sha256 == $sha)]
  | if length == 1 then .[0] else empty end
' "$manifest") || {
  echo "demo-rights-audit: audio is not an exact approved rights record" >&2
  exit 1
}

duration=$(ffprobe -v error -select_streams a:0 \
  -show_entries format=duration -of csv=p=0 "$audio")
expected_duration=$(jq -r '.duration_seconds' <<<"$track")
awk -v actual="$duration" -v expected="$expected_duration" '
  BEGIN {
    difference = actual - expected
    if (difference < 0) difference = -difference
    exit !(actual > 1 && difference <= 0.05)
  }
' || {
  echo "demo-rights-audit: approved file duration does not match its record" >&2
  exit 1
}

title=$(jq -r '.title' <<<"$track")
creator=$(jq -r '.creator' <<<"$track")
source_url=$(jq -r '.source_url' <<<"$track")
license=$(jq -r '.license' <<<"$track")
license_url=$(jq -r '.license_url' <<<"$track")
id=$(jq -r '.id' <<<"$track")
cat <<EOF
Rights record: $id
Music: "$title" by $creator
Source: $source_url
License: $license, $license_url
Changes: excerpted and synchronized to an Omadrop visual recording.
SHA-256: $sha
EOF
