#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")

usage() {
  cat <<'EOF'
Usage: omadrop-demo-record [OUTPUT.mp4]

Record the curated Omadrop showcase on the focused monitor. The default output
is a timestamped MP4 in the user's Videos directory.
EOF
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
  --*) echo "omadrop-demo-record: unknown option: $1" >&2; usage >&2; exit 2 ;;
esac

for command in ffmpeg ffprobe gpu-screen-recorder hyprctl identify jq; do
  command -v "$command" >/dev/null || {
    echo "omadrop-demo-record: required command not found: $command" >&2
    exit 1
  }
done

controlled_audio_file=${OMADROP_DEMO_AUDIO_FILE:-}
demo_cover_file=${OMADROP_DEMO_COVER_FILE:-$root/site/public/og.png}
controlled_sink_input=
demo_sink_name=
demo_sink_index=
demo_sink_module=
record_audio_device=default_output
rights_attribution=
[[ -f $demo_cover_file ]] || {
  echo "omadrop-demo-record: demo cover not found: $demo_cover_file" >&2
  exit 1
}
identify -quiet "$demo_cover_file" >/dev/null 2>&1 || {
  echo "omadrop-demo-record: demo cover is not a readable image: $demo_cover_file" >&2
  exit 1
}
if [[ -n $controlled_audio_file ]]; then
  for command in ffplay pactl; do
    command -v "$command" >/dev/null || {
      echo "omadrop-demo-record: $command is required for OMADROP_DEMO_AUDIO_FILE" >&2
      exit 1
    }
  done
  [[ -f $controlled_audio_file ]] || {
    echo "omadrop-demo-record: audio file not found: $controlled_audio_file" >&2
    exit 1
  }
  rights_attribution=$("$root/bin/demo-rights-audit" \
    "$controlled_audio_file" \
    "${OMADROP_DEMO_RIGHTS_MANIFEST:-$root/demo/music-rights.json}")
fi

check_competing_audio() {
  [[ -n $controlled_audio_file ]] || return 0
  local streams
  streams=$(pactl -f json list sink-inputs | jq -r \
    --arg controlled "$controlled_sink_input" \
    --argjson sink "$demo_sink_index" '
    .[]
    | select(.corked != true and .mute != true)
    | select(.sink == $sink)
    | select((.index | tostring) != $controlled)
    | (.properties["application.name"]
       // .properties["media.name"]
       // ("sink input " + (.index | tostring)))
  ')
  [[ -z $streams ]] || {
    echo "omadrop-demo-record: unrelated audio became active during capture:" >&2
    sed 's/^/  /' <<< "$streams" >&2
    echo "omadrop-demo-record: recording rejected" >&2
    return 1
  }
}

monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name' | head -n 1)
[[ -n $monitor && $monitor != null ]] || {
  echo "omadrop-demo-record: could not identify the focused monitor" >&2
  exit 1
}

if [[ -n ${1:-} ]]; then
  output=$(readlink -m "$1")
else
  videos_dir=$(xdg-user-dir VIDEOS 2>/dev/null || true)
  videos_dir=${videos_dir:-${HOME}/Videos}
  output=$videos_dir/omadrop-demo-$(date +%Y-%m-%d_%H-%M-%S).mp4
fi
mkdir -p "$(dirname "$output")"
[[ ! -e $output ]] || {
  echo "omadrop-demo-record: output already exists: $output" >&2
  exit 1
}

record_dir=$(mktemp -d /tmp/omadrop-demo-record.XXXXXX)
arm_file=$record_dir/armed
start_file=$record_dir/start
stop_file=$record_dir/stop
capture_file=$record_dir/capture.mp4
capture_timestamp=$capture_file.ts
finalized_file=$record_dir/finalized.mp4
recorder_log=$record_dir/recorder.log
demo_pid=
recorder_pid=
audio_player_pid=
notification_dnd_changed=0

notification_ipc() {
  qs -p /usr/share/omarchy/shell ipc call notifications "$@" 2>/dev/null
}

cleanup() {
  if [[ -n $recorder_pid ]] && kill -0 "$recorder_pid" 2>/dev/null; then
    kill -INT "$recorder_pid" 2>/dev/null || true
    wait "$recorder_pid" 2>/dev/null || true
  fi
  if [[ -n $demo_pid ]] && kill -0 "$demo_pid" 2>/dev/null; then
    kill -TERM "$demo_pid" 2>/dev/null || true
    wait "$demo_pid" 2>/dev/null || true
  fi
  if [[ -n $audio_player_pid ]] && kill -0 "$audio_player_pid" 2>/dev/null; then
    kill -TERM "$audio_player_pid" 2>/dev/null || true
    wait "$audio_player_pid" 2>/dev/null || true
  fi
  if [[ -n $demo_sink_module ]]; then
    pactl unload-module "$demo_sink_module" 2>/dev/null || true
    demo_sink_module=
  fi
  if ((notification_dnd_changed)); then
    notification_ipc setDnd off >/dev/null || true
  fi
  rm -f "$arm_file" "$start_file" "$stop_file" "$capture_file" \
    "$capture_timestamp" "$finalized_file" "$recorder_log"
  rmdir "$record_dir" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [[ -n $controlled_audio_file ]]; then
  demo_sink_name=omadrop_demo_$$
  demo_sink_module=$(pactl load-module module-null-sink \
    sink_name="$demo_sink_name" rate=48000 channels=2 \
    sink_properties=device.description=OmadropDemoCapture)
  [[ $demo_sink_module =~ ^[0-9]+$ ]] || {
    echo "omadrop-demo-record: could not create the private demo audio sink" >&2
    exit 1
  }
  demo_sink_index=$(pactl -f json list sinks | jq -r \
    --arg name "$demo_sink_name" \
    '.[] | select(.name == $name) | .index' | head -n 1)
  [[ $demo_sink_index =~ ^[0-9]+$ ]] || {
    echo "omadrop-demo-record: private demo audio sink did not appear" >&2
    exit 1
  }
  record_audio_device=$demo_sink_name.monitor
  export OMADROP_AUDIO_SINK=$demo_sink_name
  echo "omadrop-demo-record: isolated audio sink $demo_sink_name"
fi

check_competing_audio

if command -v qs >/dev/null && [[ -d /usr/share/omarchy/shell ]]; then
  notification_state=$(notification_ipc dndState || true)
  if [[ $notification_state == off ]]; then
    notification_ipc setDnd on >/dev/null || true
    notification_dnd_changed=1
  fi
  notification_ipc dismissAll >/dev/null || true
fi

export OMADROP_RECORD_ARM_FILE=$arm_file
export OMADROP_RECORD_START_FILE=$start_file
export OMADROP_RECORD_STOP_FILE=$stop_file
export OMADROP_DEMO_COVER_HOLD_SECONDS=${OMADROP_DEMO_COVER_HOLD_SECONDS:-2.5}
export OMADROP_DEMO_SCENE_MAX_SECONDS=${OMADROP_DEMO_SCENE_MAX_SECONDS:-5.25}
# A recording is a controlled presentation. Never allow an unrelated desktop
# player to supply its track identity or artwork.
export OMADROP_DISABLE_MPRIS=1
export OMADROP_COVER_PATH=$demo_cover_file
# The recording contains the digital output stream, before any Bluetooth or
# speaker latency. Device compensation would make the published visuals late.
export OMADROP_SYNC_MS=0

"$root/bin/omadrop-demo" --all &
demo_pid=$!

for ((attempt = 0; attempt < 300; attempt++)); do
  [[ -e $arm_file ]] && break
  if ! kill -0 "$demo_pid" 2>/dev/null; then
    wait "$demo_pid" || true
    echo "omadrop-demo-record: Omadrop exited before the capture was armed" >&2
    exit 1
  fi
  sleep 0.05
done
[[ -e $arm_file ]] || {
  echo "omadrop-demo-record: timed out waiting for Omadrop" >&2
  exit 1
}

gpu-screen-recorder \
  -w "$monitor" -k h264 -q very_high -tune quality \
  -f 60 -fm cfr -cursor no -fallback-cpu-encoding yes \
  -write-first-frame-ts yes \
  -a "$record_audio_device" -ac aac -o "$capture_file" \
  >"$recorder_log" 2>&1 &
recorder_pid=$!

for ((attempt = 0; attempt < 200; attempt++)); do
  [[ -e $capture_timestamp ]] && break
  if ! kill -0 "$recorder_pid" 2>/dev/null; then
    wait "$recorder_pid" || true
    echo "omadrop-demo-record: recorder stopped before its first frame" >&2
    sed -n '1,12p' "$recorder_log" >&2
    exit 1
  fi
  sleep 0.05
done
[[ -e $capture_timestamp ]] || {
  echo "omadrop-demo-record: timed out waiting for the recorder" >&2
  exit 1
}
if [[ -n $controlled_audio_file ]]; then
  PULSE_SINK=$demo_sink_name SDL_AUDIODRIVER=pulseaudio \
    ffplay -nodisp -autoexit -loglevel error "$controlled_audio_file" &
  audio_player_pid=$!
  controlled_inputs=()
  for ((attempt = 0; attempt < 40; attempt++)); do
    mapfile -t controlled_inputs < <(pactl -f json list sink-inputs | jq -r \
      --arg pid "$audio_player_pid" '
      .[]
      | select(.corked != true and .mute != true)
      | select((.properties["application.process.id"] // "") == $pid)
      | select((.properties["application.process.binary"] // "") == "ffplay")
      | .index
    ')
    ((${#controlled_inputs[@]} == 1)) && break
    kill -0 "$audio_player_pid" 2>/dev/null || break
    sleep 0.05
  done
  if ((${#controlled_inputs[@]} != 1)); then
    echo "omadrop-demo-record: could not isolate the controlled ffplay stream" >&2
    exit 1
  fi
  controlled_sink_input=${controlled_inputs[0]}
  pactl move-sink-input "$controlled_sink_input" "$demo_sink_name"
  routed_sink=
  for ((attempt = 0; attempt < 20; attempt++)); do
    routed_sink=$(pactl -f json list sink-inputs | jq -r \
      --argjson input "$controlled_sink_input" \
      '.[] | select(.index == $input) | .sink')
    [[ $routed_sink == "$demo_sink_index" ]] && break
    sleep 0.05
  done
  if [[ $routed_sink != "$demo_sink_index" ]]; then
    echo "omadrop-demo-record: controlled audio did not enter the private sink" >&2
    exit 1
  fi
  check_competing_audio
fi
touch "$start_file"

for ((attempt = 0; attempt < 2400; attempt++)); do
  [[ -e $stop_file ]] && break
  if [[ -n $controlled_audio_file ]] && ((attempt % 10 == 0)); then
    check_competing_audio || exit 1
  fi
  if ! kill -0 "$demo_pid" 2>/dev/null; then
    break
  fi
  if ! kill -0 "$recorder_pid" 2>/dev/null; then
    wait "$recorder_pid" || true
    echo "omadrop-demo-record: recorder stopped unexpectedly" >&2
    sed -n '1,12p' "$recorder_log" >&2
    exit 1
  fi
  sleep 0.05
done

if [[ -e $stop_file ]]; then
  # The encoder's last video frame trails capture time by roughly 250 ms.
  # Keep Omadrop above the desktop until that buffered frame is deep in the
  # extended recording-only fade.
  sleep 0.88
fi
kill -INT "$recorder_pid" 2>/dev/null || true
wait "$recorder_pid" || true
recorder_pid=
wait "$demo_pid" || true
demo_pid=

[[ -s $capture_file ]] || {
  echo "omadrop-demo-record: recorder did not create a video" >&2
  sed -n '1,12p' "$recorder_log" >&2
  exit 1
}
video_duration=$(ffprobe -v error -select_streams v:0 \
  -show_entries stream=duration -of csv=p=0 "$capture_file")
[[ $video_duration =~ ^[0-9]+([.][0-9]+)?$ ]] || {
  echo "omadrop-demo-record: could not read the captured video duration" >&2
  exit 1
}
ffmpeg -v error -i "$capture_file" \
  -map 0:v:0 -map '0:a:0?' -t "$video_duration" \
  -c copy -movflags +faststart "$finalized_file"
if [[ -n $controlled_audio_file ]]; then
  "$root/bin/demo-audio-audit" "$finalized_file" "$controlled_audio_file"
fi
mv "$finalized_file" "$output"
if [[ -n $rights_attribution ]]; then
  attribution_file=$output.attribution.txt
  attribution_temporary=$attribution_file.tmp.$$
  printf '%s\n' "$rights_attribution" >"$attribution_temporary"
  mv "$attribution_temporary" "$attribution_file"
  printf 'Attribution %s\n' "$attribution_file"
fi
printf 'Recorded %s\n' "$output"
