#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-launcher-test.XXXXXX")
launcher_pid=
existing_renderer=
cleanup() {
  if [[ -n $launcher_pid ]] && kill -0 "$launcher_pid" 2>/dev/null; then
    kill -TERM "$launcher_pid" 2>/dev/null || true
    wait "$launcher_pid" 2>/dev/null || true
  fi
  if [[ -n $existing_renderer ]] && kill -0 "$existing_renderer" 2>/dev/null; then
    kill -TERM "$existing_renderer" 2>/dev/null || true
    wait "$existing_renderer" 2>/dev/null || true
  fi
  rm -rf -- "$scratch"
}
trap cleanup EXIT

wait_for_count() {
  local pattern=$1 expected=$2 file=$3 label=$4
  local count
  for ((attempt = 0; attempt < 250; attempt++)); do
    count=$(grep -c "$pattern" "$file" || true)
    ((count >= expected)) && return 0
    sleep 0.02
  done
  echo "launcher test: timed out waiting for $label" >&2
  return 1
}

mkdir -p "$scratch/runtime"
events=$scratch/events.log
processes=$scratch/processes.log
hypr_log=$scratch/hypr.log
touch "$events" "$processes" "$hypr_log"

XDG_RUNTIME_DIR=$scratch/runtime \
OMADROP_HYPRCTL=$root/experiments/projectm-ascii/fixtures/fake-hyprctl \
OMADROP_LIVE_EXECUTABLE=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_RUN_CURATED=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_TEST_EVENT_LOG=$events \
OMADROP_TEST_PROCESS_FILE=$processes \
OMADROP_TEST_HYPR_LOG=$hypr_log \
OMADROP_FULLSCREEN=1 \
  "$root/bin/omadrop" --all

for index in 0 1; do
  grep -q "^ready $index$" "$events"
  grep -q "^revealed $index$" "$events"
done
first_reveal=$(grep -n '^revealed ' "$events" | head -n 1 | cut -d: -f1)
for index in 0 1; do
  ready=$(grep -n "^ready $index$" "$events" | head -n 1 | cut -d: -f1)
  ((ready < first_reveal))
done

while read -r pid index; do
  monitor=DP-1
  ((index == 0)) || monitor=HDMI-A-1
  grep -Fq "monitor = '$monitor', window = 'pid:$pid'" "$hypr_log"
  grep -Fq "mode = 'fullscreen', action = 'set', window = 'pid:$pid'" "$hypr_log"
done <"$processes"

runtime=$scratch/runtime/omadrop
[[ ! -e $runtime/pair-state ]]
[[ ! -e $runtime/pair-state.request ]]
[[ ! -e $runtime/pair-state.music ]]
[[ ! -e $runtime/start-gate ]]
if compgen -G "$runtime/display-*.pid" >/dev/null; then
  echo "launcher test: display pid files were not cleaned" >&2
  exit 1
fi

hotplug=$scratch/hotplug
mkdir -p "$hotplug/runtime"
hotplug_events=$hotplug/events.log
hotplug_processes=$hotplug/processes.log
hotplug_hypr_log=$hotplug/hypr.log
hotplug_monitors=$hotplug/monitors.json
touch "$hotplug_events" "$hotplug_processes" "$hotplug_hypr_log"
printf '[{"id":0,"name":"DP-1"},{"id":1,"name":"HDMI-A-1"}]\n' \
  >"$hotplug_monitors"

XDG_RUNTIME_DIR=$hotplug/runtime \
OMADROP_HYPRCTL=$root/experiments/projectm-ascii/fixtures/fake-hyprctl \
OMADROP_LIVE_EXECUTABLE=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_RUN_CURATED=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_TEST_EVENT_LOG=$hotplug_events \
OMADROP_TEST_PROCESS_FILE=$hotplug_processes \
OMADROP_TEST_HYPR_LOG=$hotplug_hypr_log \
OMADROP_TEST_MONITOR_FILE=$hotplug_monitors \
OMADROP_TEST_RENDERER_STAY=1 \
OMADROP_FULLSCREEN=1 \
  "$root/bin/omadrop" --all &
launcher_pid=$!

wait_for_count '^revealed ' 2 "$hotplug_events" 'initial pair reveal'
printf '[{"id":0,"name":"DP-1"}]\n' >"$hotplug_monitors.next"
mv "$hotplug_monitors.next" "$hotplug_monitors"
wait_for_count '^terminated ' 2 "$hotplug_events" 'old pair shutdown'
wait_for_count '^ready 0$' 2 "$hotplug_events" 'replacement display readiness'
wait_for_count '^revealed 0$' 2 "$hotplug_events" 'replacement display reveal'

if (( $(grep -c '^ready 1$' "$hotplug_events") != 1 )); then
  echo "launcher test: replacement retained a disconnected display" >&2
  exit 1
fi
replacement_pid=$(awk '$2 == 0 { pid = $1 } END { print pid }' "$hotplug_processes")
grep -Fq "monitor = 'DP-1', window = 'pid:$replacement_pid'" "$hotplug_hypr_log"

kill -TERM "$launcher_pid"
wait "$launcher_pid"
launcher_pid=
hotplug_runtime=$hotplug/runtime/omadrop
if compgen -G "$hotplug_runtime/display-*.pid" >/dev/null; then
  echo "launcher test: hotplug pid files were not cleaned" >&2
  exit 1
fi
[[ ! -e $hotplug_runtime/start-gate ]]

replace=$scratch/replace
mkdir -p "$replace/runtime"
replace_events=$replace/events.log
replace_processes=$replace/processes.log
replace_hypr_log=$replace/hypr.log
touch "$replace_events" "$replace_processes" "$replace_hypr_log"
fake_live=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer
bash -c 'exec -a "$1" sleep 60' _ "$fake_live" &
existing_renderer=$!
for ((attempt = 0; attempt < 50; attempt++)); do
  pgrep -f "^${fake_live//./\\.}( |$)" >/dev/null && break
  sleep 0.02
done
pgrep -f "^${fake_live//./\\.}( |$)" >/dev/null || {
  echo "launcher test: could not establish an existing renderer" >&2
  exit 1
}
OMADROP_REPLACE_RUNNING=1 \
XDG_RUNTIME_DIR=$replace/runtime \
OMADROP_HYPRCTL=$root/experiments/projectm-ascii/fixtures/fake-hyprctl \
OMADROP_LIVE_EXECUTABLE=$fake_live \
OMADROP_RUN_CURATED=$fake_live \
OMADROP_TEST_EVENT_LOG=$replace_events \
OMADROP_TEST_PROCESS_FILE=$replace_processes \
OMADROP_TEST_HYPR_LOG=$replace_hypr_log \
  "$root/bin/omadrop" --all
if kill -0 "$existing_renderer" 2>/dev/null; then
  echo "launcher test: calibration replacement retained the old renderer" >&2
  exit 1
fi
wait "$existing_renderer" 2>/dev/null || true
existing_renderer=
grep -q '^revealed 0$' "$replace_events"
grep -q '^revealed 1$' "$replace_events"

crash=$scratch/crash
mkdir -p "$crash/runtime" "$crash/state"
crash_events=$crash/events.log
crash_processes=$crash/processes.log
crash_hypr_log=$crash/hypr.log
touch "$crash_events" "$crash_processes" "$crash_hypr_log"
set +e
XDG_RUNTIME_DIR=$crash/runtime \
XDG_STATE_HOME=$crash/state \
OMADROP_HYPRCTL=$root/experiments/projectm-ascii/fixtures/fake-hyprctl \
OMADROP_LIVE_EXECUTABLE=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_RUN_CURATED=$root/experiments/projectm-ascii/fixtures/fake-launch-renderer \
OMADROP_TEST_EVENT_LOG=$crash_events \
OMADROP_TEST_PROCESS_FILE=$crash_processes \
OMADROP_TEST_HYPR_LOG=$crash_hypr_log \
OMADROP_TEST_RENDERER_EXIT=7 \
OMADROP_FULLSCREEN=1 \
  "$root/bin/omadrop" --all >"$crash/output.log" 2>&1
crash_status=$?
set -e
((crash_status == 7))
report=$crash/state/omadrop/last-crash.txt
[[ -f $report ]]
[[ $(stat -c %a "$report") == 600 ]]
grep -q '^format=1$' "$report"
grep -q '^renderer_exit_kind=code$' "$report"
grep -q '^renderer_exit_value=7$' "$report"
grep -q '^display_count=2$' "$report"
if grep -Eqi 'audio|track|artist|album|artwork|sink|mpris|path|pid' "$report"; then
  echo "launcher test: crash report contains private media fields" >&2
  exit 1
fi
XDG_STATE_HOME=$crash/state "$root/bin/omadrop-doctor" --crash-report \
  >"$crash/doctor.log"
grep -q '^renderer_exit_value=7$' "$crash/doctor.log"
grep -q 'No audio, track metadata, or artwork paths' "$crash/doctor.log"

single_crash=$scratch/single-crash
mkdir -p "$single_crash/runtime" "$single_crash/state"
set +e
XDG_RUNTIME_DIR=$single_crash/runtime \
XDG_STATE_HOME=$single_crash/state \
OMADROP_LIVE_EXECUTABLE=/usr/bin/false \
OMADROP_RUN_CURATED=/usr/bin/false \
  "$root/bin/omadrop" --single >"$single_crash/output.log" 2>&1
single_status=$?
set -e
((single_status == 1))
single_report=$single_crash/state/omadrop/last-crash.txt
grep -q '^renderer_exit_value=1$' "$single_report"
grep -q '^display_count=1$' "$single_report"

echo "launcher synchronization and hotplug passed"
