#!/usr/bin/env python3
"""Measure a synchronized review movie. Requires Python/numpy and FFmpeg.

These are diagnostic proxies, never an aesthetic score or instrument ground truth.
"""
import argparse
import json
import math
from pathlib import Path
import shutil
import subprocess

import numpy as np

FPS = 30
WIDTH, HEIGHT = 160, 90
RATE = 48000


def explain_change(previous, current):
    """Fit translation, radial scale and exposure to first-order image change."""
    average = (previous + current) * 0.5
    gy, gx = np.gradient(average)
    yy, xx = np.mgrid[:HEIGHT, :WIDTH]
    radial = -(gx * (xx - (WIDTH - 1) / 2) + gy * (yy - (HEIGHT - 1) / 2))
    delta = current - previous
    # Include a brightness gain and offset so flashing is not mistaken for zoom.
    basis = np.stack([gx, gy, average, np.ones_like(average), radial], axis=-1).reshape(-1, 5)
    target = delta.ravel()
    energy = float(target @ target)
    if energy < 1e-10:
        return 0.0, 0.0
    full = np.linalg.lstsq(basis, target, rcond=1e-5)[0]
    reduced = np.linalg.lstsq(basis[:, :4], target, rcond=1e-5)[0]
    full_error = np.square(target - basis @ full).sum()
    reduced_error = np.square(target - basis[:, :4] @ reduced).sum()
    return float(np.clip((reduced_error - full_error) / energy, 0, 1)), float(full[-1])


def regional_change(previous, current):
    delta = np.abs(current - previous)
    return np.array([part.mean() for row in np.array_split(delta, 4)
                     for part in np.array_split(row, 4, axis=1)])


def normalized(values):
    values = np.asarray(values, dtype=float)
    scale = float(np.percentile(values, 95))
    return np.clip(values / max(scale, 1e-10), 0, 2)


def lag_match(audio, visual):
    best = None
    # Positive lag means picture follows audio. Correlation is not proof of causation.
    for lag in range(-7, 8):
        a = audio[:len(audio)-lag] if lag > 0 else audio[-lag:]
        v = visual[lag:] if lag > 0 else visual[:len(visual)+lag]
        if len(a) < 8 or np.std(a) < 1e-8 or np.std(v) < 1e-8:
            continue
        r = float(np.corrcoef(a, v)[0, 1])
        if best is None or r > best['correlation']:
            best = {'lag_ms': round(lag * 1000 / FPS), 'correlation': round(r, 3)}
    return best


def inspect(movie):
    video = subprocess.Popen(['ffmpeg', '-v', 'error', '-i', str(movie), '-an',
        '-vf', f'fps={FPS},scale={WIDTH}:{HEIGHT}', '-pix_fmt', 'gray', '-f', 'rawvideo', '-'], stdout=subprocess.PIPE)
    audio = subprocess.Popen(['ffmpeg', '-v', 'error', '-i', str(movie), '-vn',
        '-ac', '1', '-ar', str(RATE), '-f', 'f32le', '-'], stdout=subprocess.PIPE)
    sample_count = RATE // FPS
    window = np.hanning(sample_count * 2)
    frequencies = np.fft.rfftfreq(len(window), 1 / RATE)
    bands = [(frequencies >= lo) & (frequencies < hi)
             for lo, hi in [(25, 180), (180, 3000), (3000, 18000)]]
    previous = None
    prior_audio = np.zeros(sample_count)
    prior_spectrum = None
    rows, maps = [], []
    try:
        while True:
            data = video.stdout.read(WIDTH * HEIGHT)
            if not data:
                break
            if len(data) != WIDTH * HEIGHT:
                raise ValueError('Incomplete video frame')
            samples = audio.stdout.read(sample_count * 4)
            # Up to one padded video frame can extend beyond the audio stream.
            if not samples and len(rows) == 0:
                raise ValueError('The review movie needs an audio track')
            chunk = np.frombuffer(samples, dtype='<f4').astype(float)
            if len(chunk) < sample_count:
                chunk = np.pad(chunk, (0, sample_count - len(chunk)))
            spectrum = np.abs(np.fft.rfft(np.concatenate([prior_audio, chunk]) * window))
            levels = [float(np.sqrt(np.mean(spectrum[band] ** 2))) for band in bands]
            flux = 0.0 if prior_spectrum is None else float(np.maximum(spectrum-prior_spectrum, 0).mean())
            image = np.frombuffer(data, dtype=np.uint8).reshape(HEIGHT, WIDTH).astype(float) / 255
            if previous is None:
                regions = np.zeros(16); radial, scale = 0.0, 0.0
            else:
                regions = regional_change(previous, image)
                radial, scale = explain_change(previous, image)
            rows.append([len(rows)/FPS, float(regions.mean()), radial, scale, flux, *levels])
            maps.append(regions)
            previous, prior_audio, prior_spectrum = image, chunk, spectrum
        if video.wait() != 0:
            raise ValueError('Video decoding failed')
        if audio.poll() is not None and audio.returncode != 0:
            raise ValueError('Audio decoding failed')
    finally:
        video.stdout.close(); audio.stdout.close()
        if video.poll() is None:
            video.terminate()
        if audio.poll() is None:
            audio.terminate()
        video.wait(); audio.wait()
    if len(rows) < FPS:
        raise ValueError('At least one second of synchronized audio/video is required')
    values = np.asarray(rows)
    regions = np.asarray(maps)
    activity = values[:, 1]
    active = activity > max(0.0001, np.percentile(activity, 40))
    active_maps = regions[active]
    if len(active_maps):
        singular = np.linalg.svd(active_maps, compute_uv=False)
        weights = singular**2 / max(float((singular**2).sum()), 1e-20)
        diversity = float(np.exp(-np.sum(weights * np.log(np.maximum(weights, 1e-20)))))
    else:
        diversity = 0.0
    # Audio onset candidates come from independent FFT flux, not Omadrop's beat estimator.
    candidates = []
    cutoff = np.percentile(values[:, 4], 80)
    for i in range(2, len(values)-1):
        if values[i, 4] > max(cutoff, 1e-7) and values[i, 4] >= values[i-1, 4] and values[i, 4] > values[i+1, 4]:
            if not candidates or i-candidates[-1] >= FPS//5:
                candidates.append(i)
    responses = [regions[i:min(i+5, len(regions))].sum(axis=0) for i in candidates]
    similarities = []
    for a, b in zip(responses, responses[1:]):
        denominator = np.linalg.norm(a)*np.linalg.norm(b)
        if denominator > 1e-10:
            similarities.append(float(a @ b / denominator))
    flags = []
    for i in candidates:
        response = float(activity[i:min(i+5, len(activity))].mean())
        if response < max(0.0001, np.percentile(activity, 20)):
            flags.append({'seconds': round(i/FPS, 2), 'reason': 'Audio onset candidate with relatively little visible change'})
    for i in range(4, len(activity)-4):
        neighborhood = np.concatenate([activity[i-4:i], activity[i+1:i+5]])
        if activity[i] > max(0.002, np.median(neighborhood)*3.5):
            if not flags or all(abs(i/FPS-f['seconds']) > 0.15 for f in flags):
                flags.append({'seconds': round(i/FPS, 2), 'reason': 'Abrupt visual change; inspect whether the sound justifies it'})
    total = max(float(activity.sum()), 1e-10)
    summary = {
        'duration_seconds': round(len(rows)/FPS, 2),
        'mean_pixel_change': round(float(activity.mean()), 6),
        'p95_pixel_change': round(float(np.percentile(activity, 95)), 6),
        'radial_scale_explained_fraction': round(float((values[:, 2]*activity).sum()/total), 4),
        'spatial_effective_rank_out_of_16': round(diversity, 3),
        'consecutive_onset_response_similarity': round(float(np.median(similarities)), 3) if similarities else None,
        'audio_onset_candidates': len(candidates),
        'flux_activity_lag': lag_match(normalized(values[:, 4]), normalized(activity)),
        'limitations': ['Radial fit is a first-order image model, not camera tracking.',
            'Spatial repetition can be musically correct. Higher diversity is not automatically better.',
            'FFT bands are frequency ranges, not separated instruments.',
            'Lag resolution is 33 ms; analysis windows and video decoding add uncertainty.',
            'No metric is an aesthetic grade or proof of audible-event accuracy.',
            'Measurements describe this recording, including its color mapping and encoding.'],
    }
    traces = np.column_stack([values[:, 0], normalized(activity), values[:, 2],
                             normalized(values[:, 4]), *[normalized(values[:, i]) for i in (5, 6, 7)]])
    return summary, np.round(traces, 5).tolist(), sorted(flags, key=lambda f:f['seconds'])


HTML = '''<!doctype html><meta charset="utf-8"><title>Omadrop musical response review</title>
<style>body{background:#11131a;color:#e8ebf3;font:16px system-ui;max-width:1080px;margin:32px auto;padding:0 24px}video{width:100%;max-height:55vh;background:#000}h1{font-size:26px}canvas{width:100%;height:300px;cursor:crosshair}button{background:#252b3b;color:inherit;border:1px solid #47506a;border-radius:6px;padding:8px;margin:4px}pre{white-space:pre-wrap;color:#bac5dc}small{color:#aab4c9}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}</style>
<h1>Musical response review</h1><p>Listen and watch the same passage. Click a plot or flagged moment to seek. These are diagnostic proxies, not a quality score.</p>
<video id="video" controls poster="poster.png" src="review.mp4"></video><canvas id="plot" width="1080" height="300"></canvas>
<small>White: visible change · pink: radial-scale fit · yellow: spectral flux · blue/green/violet: low/mid/high audio levels. Signals are normalized independently.</small>
<div class="grid"><section><h2>Measurements</h2><pre id="summary"></pre></section><section><h2>Moments to inspect</h2><div id="flags"></div></section></div>
<h2>Human review</h2><p>For a flagged moment, identify the sound, the structure you expected to respond, and what the scene actually did. Repetition is only a problem when the music calls for a different response.</p>
<script>const data=DATA;const v=document.getElementById('video'),c=document.getElementById('plot'),ctx=c.getContext('2d');document.getElementById('summary').textContent=JSON.stringify(data.summary,null,2);
for(const f of data.flags){const b=document.createElement('button');b.textContent=f.seconds+'s: '+f.reason;b.onclick=()=>{v.currentTime=f.seconds;};document.getElementById('flags').appendChild(b);}
function draw(){ctx.clearRect(0,0,c.width,c.height);const colors=['#eee','#ed81b7','#eac36a','#66aaff','#6edba4','#b79cf8'],labels=['Picture change','Radial fit','Audio flux','Low audio','Middle audio','High audio'];const lane=c.height/6;for(let ch=1;ch<=6;ch++){const base=ch*lane-5;ctx.fillStyle=colors[ch-1];ctx.font='12px system-ui';ctx.fillText(labels[ch-1],3,base-14);ctx.strokeStyle='#303748';ctx.beginPath();ctx.moveTo(110,base);ctx.lineTo(c.width,base);ctx.stroke();ctx.beginPath();ctx.strokeStyle=colors[ch-1];ctx.lineWidth=1.5;data.traces.forEach((r,i)=>{let x=110+r[0]/data.summary.duration_seconds*(c.width-110),y=base-Math.min(r[ch],1.3)/1.3*(lane-10);if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);});ctx.stroke();}ctx.strokeStyle='#fff';ctx.beginPath();const x=110+v.currentTime/data.summary.duration_seconds*(c.width-110);ctx.moveTo(x,0);ctx.lineTo(x,c.height);ctx.stroke();}
v.ontimeupdate=draw;c.onclick=e=>{v.currentTime=Math.max(0,((e.clientX-c.getBoundingClientRect().left)/c.clientWidth*c.width-110)/(c.width-110))*data.summary.duration_seconds;draw();};draw();</script>'''


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('movie', type=Path)
    parser.add_argument('output', type=Path)
    args = parser.parse_args()
    if args.output.exists():
        parser.error('Output directory already exists; use a new directory to preserve comparisons')
    summary, traces, flags = inspect(args.movie)
    args.output.mkdir(parents=True)
    shutil.copyfile(args.movie, args.output/'review.mp4')
    subprocess.run(['ffmpeg', '-v', 'error', '-y', '-ss', '0.3', '-i',
        str(args.movie), '-frames:v', '1', str(args.output/'poster.png')], check=True)
    data = {'summary': summary, 'traces': traces, 'flags': flags}
    payload = json.dumps(data, allow_nan=False).replace('<', '\\u003c')
    (args.output/'measurements.json').write_text(json.dumps(data, indent=2, allow_nan=False))
    (args.output/'index.html').write_text(HTML.replace('DATA', payload))
    print(json.dumps(summary, indent=2))
    print(args.output/'index.html')


if __name__ == '__main__':
    main()
