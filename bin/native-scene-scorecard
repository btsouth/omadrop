#!/bin/bash
set -euo pipefail

root=$(dirname "$(dirname "$(readlink -f "$0")")")
replay="$root/experiments/projectm-ascii/native-song-replay"
fixture="$root/experiments/projectm-ascii/scorecard-fixture"
scene_list="$root/experiments/projectm-ascii/native-scene-list"
shaders="$root/shaders/native"
enforce=0

if [[ ${1:-} == --enforce ]]; then
  enforce=1
  shift
fi
if (($# > 2)); then
  echo "usage: native-scene-scorecard [--enforce] [RAW_F32_STEREO] [OUTPUT_DIRECTORY]" >&2
  exit 2
fi

[[ -x $replay && -x $fixture && -x $scene_list ]] || {
  echo "native-scene-scorecard: run experiments/projectm-ascii/build.sh first" >&2
  exit 2
}
command -v ffmpeg >/dev/null || {
  echo "native-scene-scorecard: ffmpeg is required" >&2
  exit 2
}

output=${2:-$root/cache/native-scene-scorecard}
scratch=$(mktemp -d "${TMPDIR:-/tmp}/omadrop-scorecard.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

if (($# >= 1)); then
  music=$(readlink -f "$1")
  [[ -f $music ]] || {
    echo "native-scene-scorecard: input not found: $1" >&2
    exit 2
  }
  source_label=$music
else
  music="$scratch/structured-fixture.f32"
  "$fixture" "$music"
  source_label="deterministic scorecard fixture"
fi

silence="$scratch/silence.f32"
ffmpeg -hide_banner -loglevel error -f lavfi -i anullsrc=r=44100:cl=stereo \
  -t 10 -f f32le "$silence"

mkdir -p "$output"
tsv="$output/scorecard.tsv"
markdown="$output/scorecard.md"
printf 'scene\tquiet_motion\tquiet_coverage\tmotion_grammar\tquiet_coverage_limit\tglobal_pulse_limit\tmean_global_pulse\tpulse_duty_10\tpulse_duty_10_limit\tpulse_duty_20\tpulse_duty_20_limit\tbeat_gain\tkick_gain\tsnare_gain\that_gain\tonset_gain\tkick_coverage\tsnare_coverage\that_coverage\tkick_coherence\tsnare_coherence\that_coherence\tkick_global_pulse\tsnare_global_pulse\that_global_pulse\tkick_recovery\tsnare_recovery\that_recovery\tmotion_review\tsilence_drift\tstatus\n' > "$tsv"

metric() {
  local line=$1 key=$2
  sed -n "s/.* ${key}=\\([^ ]*\\).*/\\1/p" <<< "$line"
}

mapfile -t scenes < <("$scene_list")
((${#scenes[@]} > 0)) || {
  echo "native-scene-scorecard: native scene registry is empty" >&2
  exit 1
}
failed=0
for row in "${scenes[@]}"; do
  IFS=$'\t' read -r scene name <<< "$row"
  scene_output="$output/$scene"
  mkdir -p "$scene_output/music" "$scene_output/silence"
  echo "measuring $name"
  music_log=$(OMADROP_REPLAY_SCENE="$scene" OMADROP_REPLAY_MEASURE=1 \
    OMADROP_REPLAY_CAPTURE_HOPS=100000 \
    "$replay" "$shaders" "$music" "$scene_output/music" 2>&1)
  printf '%s\n' "$music_log" > "$scene_output/music.log"
  music_line=$(sed -n '/^motion /p' <<< "$music_log")
  [[ -n $music_line ]] || {
    echo "native-scene-scorecard: missing music metrics for $name" >&2
    exit 1
  }

  silence_log=$(OMADROP_REPLAY_SCENE="$scene" OMADROP_REPLAY_MEASURE=1 \
    OMADROP_REPLAY_CAPTURE_HOPS=100000 \
    "$replay" "$shaders" "$silence" "$scene_output/silence" 2>&1)
  printf '%s\n' "$silence_log" > "$scene_output/silence.log"
  silence_line=$(sed -n '/^motion /p' <<< "$silence_log")
  [[ -n $silence_line ]] || {
    echo "native-scene-scorecard: missing silence metrics for $name" >&2
    exit 1
  }

  quiet=$(metric "$music_line" quiet)
  quiet_coverage=$(metric "$music_line" quiet_coverage)
  grammar=$(metric "$music_line" grammar)
  quiet_coverage_limit=$(metric "$music_line" quiet_coverage_limit)
  global_pulse_limit=$(metric "$music_line" global_pulse_limit)
  mean_global_pulse=$(metric "$music_line" mean_global_pulse)
  pulse_duty_10=$(metric "$music_line" pulse_duty_10)
  pulse_duty_20=$(metric "$music_line" pulse_duty_20)
  case "$grammar" in
    sparse)
      pulse_duty_10_limit=0.25
      pulse_duty_20_limit=0.12
      ;;
    selective)
      pulse_duty_10_limit=0.45
      pulse_duty_20_limit=0.12
      ;;
    flow)
      pulse_duty_10_limit=0.48
      pulse_duty_20_limit=0.25
      ;;
    *)
      echo "native-scene-scorecard: unknown motion grammar for $name: $grammar" >&2
      exit 1
      ;;
  esac
  beat=$(metric "$music_line" beat | tr -d x)
  kick=$(metric "$music_line" kick | tr -d x)
  snare=$(metric "$music_line" snare | tr -d x)
  hat=$(metric "$music_line" hat | tr -d x)
  onset=$(metric "$music_line" onset | tr -d x)
  kick_coverage=$(metric "$music_line" kick_coverage)
  snare_coverage=$(metric "$music_line" snare_coverage)
  hat_coverage=$(metric "$music_line" hat_coverage)
  kick_coherence=$(metric "$music_line" kick_coherence)
  snare_coherence=$(metric "$music_line" snare_coherence)
  hat_coherence=$(metric "$music_line" hat_coherence)
  kick_global_pulse=$(awk -v coverage="$kick_coverage" \
    -v coherence="$kick_coherence" 'BEGIN { print coverage * coherence }')
  snare_global_pulse=$(awk -v coverage="$snare_coverage" \
    -v coherence="$snare_coherence" 'BEGIN { print coverage * coherence }')
  hat_global_pulse=$(awk -v coverage="$hat_coverage" \
    -v coherence="$hat_coherence" 'BEGIN { print coverage * coherence }')
  kick_recovery=$(metric "$music_line" kick_recovery)
  snare_recovery=$(metric "$music_line" snare_recovery)
  hat_recovery=$(metric "$music_line" hat_recovery)
  drift=$(metric "$silence_line" quiet)
  motion_review=selective
  awk -v kick="$kick_coverage" -v snare="$snare_coverage" -v hat="$hat_coverage" '
    BEGIN {
      minimum = kick < snare ? kick : snare
      minimum = minimum < hat ? minimum : hat
      maximum = kick > snare ? kick : snare
      maximum = maximum > hat ? maximum : hat
      average = (kick + snare + hat) / 3.0
      exit !(average >= 0.60 && maximum - minimum < 0.18)
    }' && motion_review=broad || true
  awk -v kick="$kick_recovery" -v snare="$snare_recovery" -v hat="$hat_recovery" '
    BEGIN { exit !((kick + snare + hat) / 3.0 >= 0.75) }' && {
      [[ $motion_review == selective ]] && motion_review=slow-recovery \
        || motion_review=broad+slow-recovery
    } || true
  status=PASS
  awk -v beat="$beat" -v kick="$kick" -v snare="$snare" -v hat="$hat" \
    -v drift="$drift" \
    -v quiet_coverage="$quiet_coverage" -v limit="$quiet_coverage_limit" \
    -v pulse_limit="$global_pulse_limit" -v kick_pulse="$kick_global_pulse" \
    -v snare_pulse="$snare_global_pulse" -v hat_pulse="$hat_global_pulse" \
    -v pulse_duty_10="$pulse_duty_10" \
    -v duty_10_limit="$pulse_duty_10_limit" \
    -v pulse_duty_20="$pulse_duty_20" \
    -v duty_20_limit="$pulse_duty_20_limit" \
    'BEGIN { exit !(beat >= 1.75 && kick >= 1.75 && snare >= 1.75 && hat >= 1.75 && drift <= 0.003 && quiet_coverage <= limit && kick_pulse <= pulse_limit && snare_pulse <= pulse_limit && hat_pulse <= pulse_limit && pulse_duty_10 <= duty_10_limit && pulse_duty_20 <= duty_20_limit) }' || {
      status=TUNE
      failed=1
    }
  if [[ $motion_review != selective ]]; then
    status=TUNE
    failed=1
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$name" "$quiet" "$quiet_coverage" "$grammar" "$quiet_coverage_limit" \
    "$global_pulse_limit" "$mean_global_pulse" "$pulse_duty_10" \
    "$pulse_duty_10_limit" "$pulse_duty_20" "$pulse_duty_20_limit" \
    "$beat" "$kick" "$snare" "$hat" "$onset" \
    "$kick_coverage" "$snare_coverage" "$hat_coverage" \
    "$kick_coherence" "$snare_coherence" "$hat_coherence" \
    "$kick_global_pulse" "$snare_global_pulse" "$hat_global_pulse" \
    "$kick_recovery" "$snare_recovery" "$hat_recovery" "$motion_review" \
    "$drift" "$status" \
    >> "$tsv"
done

{
  echo '# Native scene scorecard'
  echo
  echo "Audio: $source_label"
  echo
  echo 'The beat, kick, snare, and hat floor is 1.75x quiet motion. The absolute silence-drift ceiling is 0.003. Each scene also has a non-transient motion coverage budget based on its sparse, selective, or flow grammar. Global pulse combines changed area with same-direction luminance motion, so a full-frame flash approaches 1.0 while localized or counter-moving detail stays lower. Two duty limits prevent moderate broad motion from becoming constant before it reaches the existing severe-pulse threshold. A scene also fails when kick, snare, and hat all move a similarly broad area, or when their responses recover so slowly that they accumulate into constant motion. Recovery compares motion 167 ms after an isolated hit with motion on the hit; a new transient cancels that sample. These are regression gates, not a substitute for visual review.'
  echo
  echo '| Scene | Grammar | Quiet coverage | Pulse duty 10/20 | Beat | Kick | Snare | Hat | K/S/H coverage | K/S/H global pulse | K/S/H recovery | Motion | Silence | Status |'
  echo '| --- | :---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | :---: | ---: | :---: |'
  tail -n +2 "$tsv" | while IFS=$'\t' read -r name quiet quiet_coverage grammar quiet_coverage_limit global_pulse_limit mean_global_pulse pulse_duty_10 pulse_duty_10_limit pulse_duty_20 pulse_duty_20_limit beat kick snare hat onset kick_coverage snare_coverage hat_coverage kick_coherence snare_coherence hat_coherence kick_global_pulse snare_global_pulse hat_global_pulse kick_recovery snare_recovery hat_recovery motion_review drift status; do
    printf '| %s | %s | %.0f/%.0f%% | %.0f/%.0f%%, %.0f/%.0f%% | %.2fx | %.2fx | %.2fx | %.2fx | %.0f/%.0f/%.0f%% | %.0f/%.0f/%.0f%% | %.0f/%.0f/%.0f%% | %s | %.5f | %s |\n' \
      "$name" "$grammar" \
      "$(awk -v value="$quiet_coverage" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$quiet_coverage_limit" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$pulse_duty_10" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$pulse_duty_10_limit" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$pulse_duty_20" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$pulse_duty_20_limit" 'BEGIN { print value * 100 }')" \
      "$beat" "$kick" "$snare" "$hat" \
      "$(awk -v value="$kick_coverage" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$snare_coverage" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$hat_coverage" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$kick_global_pulse" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$snare_global_pulse" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$hat_global_pulse" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$kick_recovery" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$snare_recovery" 'BEGIN { print value * 100 }')" \
      "$(awk -v value="$hat_recovery" 'BEGIN { print value * 100 }')" \
      "$motion_review" "$drift" "$status"
  done
} > "$markdown"

echo "scorecard: $markdown"
if ((failed)); then
  echo "native scene scorecard has scenes to tune" >&2
  ((enforce == 0)) || exit 1
else
  echo "native scene scorecard passed"
fi
