---
import "../styles/global.css";

const title = "Omadrop | See the music";
const description = "21 curated MilkDrop visuals with Omadrop audio adaptations, album artwork and desktop audio capture.";
const scenes = [
  [
    "collection-01",
    "Cloud Cubes",
    "flexi - bouncing icecubes"
  ],
  [
    "collection-02",
    "Fractal Caves",
    "martin - mandelbox explorer - wreck diver nz+ phranq"
  ],
  [
    "collection-03",
    "Ice Wave",
    "martin - rogue wave -ps3"
  ],
  [
    "collection-04",
    "Color Spiral",
    "yin - 350 - Chromatron"
  ],
  [
    "collection-05",
    "Living Cells",
    "_Geiss - Reaction Diffusion 3 (Lichen Relief Mix)"
  ],
  [
    "collection-06",
    "Liquid Ice",
    "Flexi - crush ice 62"
  ],
  [
    "collection-07",
    "Neon Orbits",
    "Serge + martin - crystal palace010"
  ],
  [
    "collection-08",
    "Aqua Filaments",
    "Goody + martin - crystal palace - Aqua Lumens5"
  ],
  [
    "collection-09",
    "Pixie Swarm",
    "martin - pixies party"
  ],
  [
    "collection-10",
    "Desert Rose",
    "Geiss - Desert Rose 4"
  ],
  [
    "collection-11",
    "Silk Spiral",
    "flexi - swing out on the spiral"
  ],
  [
    "collection-12",
    "Crystal Palace",
    "martin - crystal palace"
  ],
  [
    "collection-13",
    "Organic Light",
    "martin - organic light"
  ],
  [
    "collection-14",
    "Peacock Weave",
    "TonyMilkdrop - Dawning The Peacocks [Flexi - quirks + multiverse]"
  ],
  [
    "collection-15",
    "Infinity Layers",
    "martin - infinity"
  ],
  [
    "collection-16",
    "Spiral of Light",
    "LuX - Spiral of Light (Minimal Mix)"
  ],
  [
    "collection-17",
    "Fractal Flight",
    "martin - mandelbox explorer - high speed demo version"
  ],
  [
    "collection-18",
    "Water Glowsticks",
    "Eo.S. + Geiss - glowsticks v2 03 music shifter edit b (water mix)"
  ],
  [
    "collection-19",
    "Silver Pixies",
    "Martin - Pixies Party (Hakan mash-up) 9-1"
  ],
  [
    "collection-20",
