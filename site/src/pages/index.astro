---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050606" />
    <link rel="canonical" href="https://omadrop.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omadrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://omadrop.com/" />
    <meta property="og:image" content="https://omadrop.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Omadrop MilkDrop collection" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://omadrop.com/og.png" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <video
          class="hero__film"
          autoplay
          muted
          playsinline
          preload="metadata"
          poster="/media/collection-poster.jpg"
          aria-hidden="true"
        >
          <source media="(max-width: 720px)" src="/media/collection.mp4" type="video/mp4" />
          <source src="/media/collection.mp4" type="video/mp4" />
        </video>
        <div class="hero__shade"></div>

        <nav class="nav" aria-label="Primary">
          <a class="wordmark" href="#top" aria-label="Omadrop home">
            <span aria-hidden="true">⣿</span> omadrop
          </a>
          <span class="status"><i></i> v0.5.0</span>
        </nav>

        <div class="hero__copy" id="top">
          <p class="eyebrow">music visuals for omarchy</p>
          <h1 id="hero-title">see the<br />music.</h1>
          <p class="lede">21 MilkDrop scenes. 37 terminal effects. One app.</p>
          <a class="button" href="#story">Choose your mode <span aria-hidden="true">↓</span></a>
        </div>

        <p class="hero__note" aria-hidden="true">MILKDROP / OMARCHY / LOCAL AUDIO</p>
        <div class="hero__index" aria-hidden="true"><span>01</span><b></b><span>OMADROP</span></div>
      </section>

      <section class="manifesto" id="story" aria-labelledby="story-title">
        <p class="section-id">01 / OPEN, CHOOSE, PLAY</p>
        <h2 id="story-title">Two modes.<br />Controls first.</h2>
        <p class="manifesto__body">
          Open Omadrop to a compact panel with a thumbnail grid. Choose MilkDrop
          for 21 curated presets with added audio response, blended
          transitions and an optional ASCII dot filter. Choose Omarchy for the
          screensaver's 37 ttfx effects, driven by your music. Press Play or
          click a card to start. Esc brings you back to the controls.
        </p>
      </section>

      <section class="proof" aria-labelledby="proof-title">
        <div class="proof__intro">
          <p class="section-id">02 / WATCH OMADROP</p>
          <h2 id="proof-title">MilkDrop<br />in motion.</h2>
          <p>A recording of the MilkDrop collection reacting to music. <a href="/media/collection-attribution.txt">Music credits</a>.</p>
        </div>
        <button class="proof__stage" type="button" aria-label="Open Omadrop performance fullscreen">
          <video autoplay muted loop playsinline preload="none" poster="/media/collection-poster.jpg" aria-hidden="true">
            <source src="/media/collection.mp4" type="video/mp4" />
          </video>
          <span>view performance <b>↗</b></span>
        </button>
      </section>

      <dialog class="player" aria-label="Omadrop performance">
        <button class="player__close" type="button" aria-label="Close performance">close ×</button>
        <video controls muted playsinline preload="metadata" poster="/media/collection-poster.jpg">
          <source src="/media/collection.mp4" type="video/mp4" />
        </video>
      </dialog>

      <section class="worlds" id="worlds" aria-labelledby="worlds-title">
        <div class="worlds__intro">
          <p class="section-id">03 / THE COLLECTION</p>
          <h2 id="worlds-title">21 curated<br />MilkDrop scenes.</h2>
          <p>
            Authored by MilkDrop artists, selected for variety, and adapted for
            Omadrop. These are actual frames from the collection.
          </p>
        </div>
        <div class="worlds__grid">
          {scenes.map(([slug, name, family], index) => (
            <figure class="scene-card">
              <img
                src={`/media/scenes/${slug}.jpg`}
                alt={`${name}, a curated MilkDrop preset in Omadrop`}
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span>{String(index + 1).padStart(2, "0")} / {name}</span>
                <small>{family}</small>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="worlds" id="effects" aria-labelledby="effects-title">
        <div class="worlds__intro">
          <p class="section-id">04 / OMARCHY MODE</p>
          <h2 id="effects-title">37 effects.<br />Your music sets the pace.</h2>
          <p>
            The ttfx terminal effects from the Omarchy screensaver, with music
            driving their movement. Browse, favorite, hide or preview effects
            in the controls. Every enabled effect gets a turn in the rotation.
            These thumbnails show the actual effects.
          </p>
        </div>
        <div class="worlds__grid">
          {effects.map(([slug, name], index) => (
            <figure class="scene-card">
              <img src={`/media/effects/${slug}.jpg`} alt={`${name}, a ttfx terminal effect`}
                width="480" height="270" loading="lazy" decoding="async" />
              <figcaption>
                <span>{String(index + 1).padStart(2, "0")} / {name}</span>
                <small>ttfx / TerminalTextEffects</small>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="engine" aria-labelledby="engine-title">
        <div class="engine__field" aria-hidden="true">
          <span>⠁⠂⠄⡀⢀⠠⠐⠈</span><span>⣿⣷⣤⣀⣀⣤⣾⣿</span><span>⠈⠐⠠⢀⡀⠄⠂⠁</span>
        </div>
        <div class="engine__content">
          <p class="section-id">05 / THE SIGNAL PATH</p>
          <h2 id="engine-title">Your audio.<br />Local processing.</h2>
          <ol class="signal" aria-label="Omadrop signal path">
            <li><span>01</span>PipeWire output</li>
            <li><span>02</span>music analysis</li>
            <li><span>03</span>MilkDrop / Omarchy</li>
            <li><span>04</span>music-driven visuals</li>
          </ol>
        </div>
      </section>

      <section class="close" aria-labelledby="close-title">
        <p class="section-id">BUILT FOR OMARCHY</p>
        <h2 id="close-title">Install.<br />Open Omadrop.<br />Press Play.</h2>
        <p class="close__status">Download the Arch package from the release page, then run:</p>
        <pre class="install-command"><code>sudo pacman -U omadrop-*.pkg.tar.zst</code></pre>
        <p class="close__status">From source: <code>packaging/makepkg.sh -si</code> or <code>./install.sh</code>.</p>
        <p class="close__status">Requires Omarchy, Hyprland and PipeWire on Arch Linux.</p>
        <a class="button" href="https://github.com/btsouth/omadrop/releases">View releases <span aria-hidden="true">↗</span></a>
        <p class="close__status"><a href="https://github.com/btsouth/omadrop/blob/master/THIRD_PARTY_NOTICES.md">Preset credits and licenses</a>. Omadrop code is MIT licensed. Built with projectM, MilkDrop artists, ttfx and TerminalTextEffects. Presets keep their authors' rights. <a href="https://github.com/btsouth/omadrop/issues/new/choose">Request a correction or removal</a>.</p>
      </section>
    </main>

    <script>
      const video = document.querySelector(".hero__film");
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
      if (video instanceof HTMLVideoElement) {
        if (reduceMotion.matches) video.removeAttribute("autoplay");
        video.addEventListener("ended", () => document.body.classList.add("hero-finished"));
      }

      const stage = document.querySelector(".proof__stage");
      const player = document.querySelector(".player");
      const playerVideo = player?.querySelector("video");
      const closePlayer = player?.querySelector(".player__close");
      if (stage instanceof HTMLButtonElement && player instanceof HTMLDialogElement && playerVideo instanceof HTMLVideoElement) {
        stage.addEventListener("click", () => {
          player.showModal();
          playerVideo.currentTime = 0;
          void playerVideo.play();
        });
        const close = () => {
          playerVideo.pause();
          player.close();
        };
        closePlayer?.addEventListener("click", close);
        player.addEventListener("close", () => playerVideo.pause());
        player.addEventListener("click", (event) => {
          if (event.target === player) close();
        });
      }
    </script>
  </body>
</html>
