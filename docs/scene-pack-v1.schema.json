{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/btsouth/omadrop/docs/scene-pack-v1.schema.json",
  "title": "Omadrop native scene pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "author", "license", "scenes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "name": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/scene"}
    }
  },
  "$defs": {
    "unitValue": {"type": "number", "minimum": 0, "maximum": 1},
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "name", "shader", "roles", "transitionAnchor",
        "motionGrammar", "visualFamily", "selection", "limits", "attribution"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {"type": "string", "minLength": 1},
        "shader": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.frag$"
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {"contains": {"const": "kick"}},
            {"contains": {"const": "snare"}},
            {"contains": {"const": "hat"}}
          ],
          "items": {
            "enum": ["kick", "snare", "hat", "groove", "harmony", "structure"]
          }
        },
        "transitionAnchor": {
          "enum": ["center", "horizontal-axis", "vertical-axis", "depth-point"]
        },
        "motionGrammar": {"enum": ["sparse", "selective", "flow"]},
        "visualFamily": {
          "enum": [
            "depth", "radial", "filament", "vertical", "landscape",
            "network", "minimal", "fluid", "faceted", "cellular", "custom"
          ]
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["energy", "percussive", "harmonic", "centroid", "stereo"],
          "properties": {
            "energy": {"$ref": "#/$defs/unitValue"},
            "percussive": {"$ref": "#/$defs/unitValue"},
            "harmonic": {"$ref": "#/$defs/unitValue"},
            "centroid": {"$ref": "#/$defs/unitValue"},
            "stereo": {"$ref": "#/$defs/unitValue"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quietMotionCoverage", "globalPulse", "frameMilliseconds"],
          "properties": {
            "quietMotionCoverage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "globalPulse": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.35
            },
            "frameMilliseconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 18.5
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author", "license"],
          "properties": {
            "author": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
